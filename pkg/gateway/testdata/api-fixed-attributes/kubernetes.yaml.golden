apiVersion: v1
data:
  envoy.yaml: |
    # Generated by github.com/rhobs/auth-gateway.
    admin:
        address:
            socket_address:
                address: 127.0.0.1
                port_value: 9901
    node:
        cluster: auth-gateway
        id: auth-gateway
    static_resources:
        clusters:
            - circuit_breakers:
                thresholds:
                    - max_connections: 1024
                      max_pending_requests: 1024
                      max_requests: 1024
                      max_retries: 0
              connect_timeout: 5s
              load_assignment:
                cluster_name: api-metrics
                endpoints:
                    - lb_endpoints:
                        - endpoint:
                            address:
                                socket_address:
                                    address: metrics.example.test
                                    port_value: 8080
              name: api-metrics
              per_connection_buffer_limit_bytes: 1048576
              type: STRICT_DNS
              typed_extension_protocol_options:
                envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
                    '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
                    explicit_http_config:
                        http_protocol_options: {}
            - circuit_breakers:
                thresholds:
                    - max_connections: 1024
                      max_pending_requests: 1024
                      max_requests: 1024
                      max_retries: 0
              connect_timeout: 5s
              load_assignment:
                cluster_name: api-plain
                endpoints:
                    - lb_endpoints:
                        - endpoint:
                            address:
                                socket_address:
                                    address: plain.example.test
                                    port_value: 8080
              name: api-plain
              per_connection_buffer_limit_bytes: 1048576
              type: STRICT_DNS
              typed_extension_protocol_options:
                envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
                    '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
                    explicit_http_config:
                        http_protocol_options: {}
        listeners:
            - address:
                socket_address:
                    address: 0.0.0.0
                    port_value: 8080
              filter_chains:
                - filters:
                    - name: envoy.filters.network.http_connection_manager
                      typed_config:
                        '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                        access_log:
                            - filter:
                                status_code_filter:
                                    comparison:
                                        op: GE
                                        value:
                                            default_value: 400
                              name: envoy.access_loggers.stdout
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                                log_format:
                                    json_format:
                                        bytes_received: '%BYTES_RECEIVED%'
                                        bytes_sent: '%BYTES_SENT%'
                                        connection_termination: '%CONNECTION_TERMINATION_DETAILS%'
                                        duration_ms: '%DURATION%'
                                        method: '%REQ(:METHOD)%'
                                        path: '%PATH(NQ)%'
                                        request_id: '%REQ(X-REQUEST-ID)%'
                                        response_code_details: '%RESPONSE_CODE_DETAILS%'
                                        response_flags: '%RESPONSE_FLAGS%'
                                        route: '%ROUTE_NAME%'
                                        status: '%RESPONSE_CODE%'
                                        timestamp: '%START_TIME%'
                                        upstream_cluster: '%UPSTREAM_CLUSTER%'
                                        upstream_host: '%UPSTREAM_HOST%'
                                        upstream_transport_failure: '%UPSTREAM_TRANSPORT_FAILURE_REASON%'
                        common_http_protocol_options:
                            headers_with_underscores_action: REJECT_REQUEST
                            idle_timeout: 60s
                            max_headers_count: 100
                            max_stream_duration: 30s
                        http_filters:
                            - name: auth_gateway.request_controls
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: x-envoy-original-path
                                        - remove: x-envoy-retry-on
                                        - remove: x-envoy-retry-grpc-on
                                        - remove: x-envoy-max-retries
                                        - remove: x-envoy-hedge-on-per-try-timeout
                                        - remove: x-envoy-upstream-rq-timeout-ms
                                        - remove: x-envoy-upstream-rq-per-try-timeout-ms
                                        - remove: x-envoy-expected-rq-timeout-ms
                                        - remove: x-envoy-upstream-alt-stat-name
                                        - remove: x-envoy-upstream-stream-duration-ms
                                        - remove: x-envoy-upstream-rq-timeout-alt-response
                                        - remove: x-envoy-retriable-status-codes
                                        - remove: x-envoy-retriable-header-names
                                        - remove: x-auth-gateway-request-validation-pending
                                        - remove: x-auth-gateway-api-key-client
                                        - remove: x-auth-gateway-mtls-fingerprint
                                        - remove: x-auth-gateway-mtls-uri-san
                                        - remove: x-auth-gateway-mtls-dns-san
                            - name: envoy.filters.http.lua
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
                                default_source_code:
                                    inline_string: |
                                        local labels = {"operation"}
                                        local counter_name = "auth_gateway_http_requests_total"

                                        local function safe_label(value)
                                          if type(value) ~= "string" or #value == 0 or #value > 128 then
                                            return "__unattributed__"
                                          end
                                          for i = 1, #value do
                                            local byte = string.byte(value, i)
                                            if byte < 32 or byte > 126 or byte == 124 then
                                              return "__unattributed__"
                                            end
                                          end
                                          return value
                                        end

                                        function envoy_on_response(response_handle)
                                          local metadata = response_handle:metadata()
                                          if metadata == nil then
                                            return
                                          end
                                          local api = metadata:get("api")
                                          if type(api) ~= "string" or api == "" then
                                            return
                                          end
                                          local status = response_handle:headers():get(":status")
                                          if type(status) ~= "string" or not string.match(status, "^%d%d%d$") then
                                            return
                                          end

                                          local bindings = metadata:get("labels") or {}
                                          local filter_state = response_handle:streamInfo():filterState()
                                          local name = counter_name .. "|api=" .. api .. "|http_status_code=" .. status
                                          for _, label in ipairs(labels) do
                                            local attribute = bindings[label]
                                            local value = nil
                                            if type(attribute) == "string" then
                                              value = filter_state:get("auth_gateway.attributes." .. attribute)
                                            end
                                            name = name .. "|" .. label .. "=" .. safe_label(value)
                                          end
                                          response_handle:stats():counter(name):inc()
                                        end
                            - disabled: true
                              name: auth_gateway.api_attributes
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                            - name: auth_gateway.required_headers
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                            - name: auth_gateway.credentials
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: authorization
                                        - remove: x-auth-gateway-api-key-client
                                        - remove: x-auth-gateway-request-validation-pending
                            - name: envoy.filters.http.header_mutation
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: x-operation
                            - name: envoy.filters.http.router
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                        local_reply_config:
                            mappers:
                                - filter:
                                    and_filter:
                                        filters:
                                            - status_code_filter:
                                                comparison:
                                                    value:
                                                        default_value: 403
                                            - header_filter:
                                                header:
                                                    name: x-auth-gateway-request-validation-pending
                                                    string_match:
                                                        exact: "true"
                                  status_code: 400
                        max_request_headers_kb: 32
                        normalize_path: true
                        path_with_escaped_slashes_action: UNESCAPE_AND_FORWARD
                        request_headers_timeout: 5s
                        request_timeout: 30s
                        route_config:
                            ignore_port_in_host_matching: true
                            name: ingestion
                            virtual_hosts:
                                - domains:
                                    - gateway.example.test
                                  name: gateway.example.test
                                  routes:
                                    - match:
                                        headers:
                                            - name: :method
                                              string_match:
                                                exact: GET
                                        path: /metrics
                                      metadata:
                                        filter_metadata:
                                            auth_gateway.api_attributes:
                                                api: metrics
                                                role: metrics:read
                                            envoy.filters.http.lua:
                                                api: metrics
                                                labels:
                                                    operation: role
                                            envoy.filters.http.rbac:
                                                api: metrics
                                      name: api-0-metrics-route-0-method-0
                                      route:
                                        cluster: api-metrics
                                        idle_timeout: 60s
                                        max_stream_duration:
                                            max_stream_duration: 30s
                                        timeout: 30s
                                      stat_prefix: api-0-metrics-route-0-method-0
                                      typed_per_filter_config:
                                        auth_gateway.api_attributes:
                                            '@type': type.googleapis.com/envoy.config.route.v3.FilterConfig
                                            config:
                                                '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                                                on_request_headers:
                                                    - factory_key: envoy.string
                                                      format_string:
                                                        omit_empty_values: true
                                                        text_format_source:
                                                            inline_string: '%METADATA(ROUTE:auth_gateway.api_attributes:api)%'
                                                      object_key: auth_gateway.attributes.api
                                                      skip_if_empty: true
                                                    - factory_key: envoy.string
                                                      format_string:
                                                        omit_empty_values: true
                                                        text_format_source:
                                                            inline_string: '%METADATA(ROUTE:auth_gateway.api_attributes:role)%'
                                                      object_key: auth_gateway.attributes.role
                                                      skip_if_empty: true
                                        auth_gateway.required_headers:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                            rbac:
                                                rules:
                                                    policies:
                                                        required-attributes:
                                                            permissions:
                                                                - any: true
                                                            principals:
                                                                - filter_state:
                                                                    key: auth_gateway.attributes.role
                                                                    string_match:
                                                                        safe_regex:
                                                                            regex: ^[^\x00-\x1f\x7f]+$
                                        envoy.filters.http.header_mutation:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutationPerRoute
                                            mutations:
                                                request_mutations:
                                                    - append:
                                                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                                        header:
                                                            key: X-Operation
                                                            value: '%FILTER_STATE(auth_gateway.attributes.role:PLAIN)%'
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                    - match:
                                        headers:
                                            - name: :method
                                              string_match:
                                                exact: GET
                                        path: /plain
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: plain
                                      name: api-1-plain-route-0-method-0
                                      route:
                                        cluster: api-plain
                                        idle_timeout: 60s
                                        max_stream_duration:
                                            max_stream_duration: 30s
                                        timeout: 30s
                                      stat_prefix: api-1-plain-route-0-method-0
                                      typed_per_filter_config:
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                    - direct_response:
                                        status: 405
                                      match:
                                        path: /metrics
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: __local
                                      name: method-not-allowed-0
                                      response_headers_to_add:
                                        - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                          header:
                                            key: allow
                                            value: GET
                                      typed_per_filter_config:
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                    - direct_response:
                                        status: 405
                                      match:
                                        path: /plain
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: __local
                                      name: method-not-allowed-1
                                      response_headers_to_add:
                                        - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                          header:
                                            key: allow
                                            value: GET
                                      typed_per_filter_config:
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                    - direct_response:
                                        status: 404
                                      match:
                                        prefix: /
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: __local
                                      name: not-found
                                      typed_per_filter_config:
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                  typed_per_filter_config:
                                    envoy.filters.http.rbac:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                        stat_prefix: ingress
                        stream_flush_timeout: 5s
                        stream_idle_timeout: 60s
              name: ingestion
              per_connection_buffer_limit_bytes: 1048576
    stats_config:
        stats_tags:
            - regex: ^http\.ingress\.lua\.auth_gateway_http_requests_total(\|api=([^|]+))
              tag_name: api
            - regex: ^http\.ingress\.lua\.auth_gateway_http_requests_total\|api=[^|]+(\|http_status_code=([^|]+))
              tag_name: http_status_code
            - regex: ^http\.ingress\.lua\.auth_gateway_http_requests_total\|api=[^|]+\|http_status_code=[^|]+(\|operation=([^|]+))
              tag_name: operation
kind: ConfigMap
metadata:
  name: auth-gateway-config
  namespace: observability
---
apiVersion: v1
data:
  config.yaml: |
    receivers:
      prometheus:
        config:
          scrape_configs:
            - job_name: auth-gateway
              scrape_interval: 30s
              scrape_timeout: 10s
              metrics_path: /stats/prometheus
              static_configs:
                - targets:
                    - 127.0.0.1:9901
    processors:
      transform:
        metric_statements:
          - context: metric
            statements:
              - replace_pattern(name, "^envoy_http_lua_", "")
    exporters:
      prometheus:
        endpoint: 0.0.0.0:8889
    service:
      pipelines:
        metrics:
          receivers:
            - prometheus
          processors:
            - transform
          exporters:
            - prometheus
kind: ConfigMap
metadata:
  name: auth-gateway-metrics
  namespace: observability
---
apiVersion: v1
automountServiceAccountToken: false
kind: ServiceAccount
metadata:
  labels:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  name: auth-gateway
  namespace: observability
---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  name: auth-gateway
  namespace: observability
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/instance: auth-gateway
      app.kubernetes.io/name: auth-gateway
  strategy: {}
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: auth-gateway
        app.kubernetes.io/name: auth-gateway
    spec:
      automountServiceAccountToken: false
      containers:
      - args:
        - -c
        - /etc/auth-gateway/envoy.yaml
        - --log-level
        - info
        image: envoyproxy/envoy:v1.39.1
        imagePullPolicy: IfNotPresent
        lifecycle:
          preStop:
            exec:
              command:
              - /bin/sh
              - -c
              - sleep 5
        name: envoy
        ports:
        - containerPort: 8080
          name: http
          protocol: TCP
        - containerPort: 9901
          name: admin
          protocol: TCP
        readinessProbe:
          failureThreshold: 12
          periodSeconds: 5
          tcpSocket:
            port: http
        resources:
          limits:
            cpu: "1"
            memory: 256Mi
          requests:
            cpu: 50m
            memory: 64Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
          runAsGroup: 101
          runAsNonRoot: true
          runAsUser: 101
        volumeMounts:
        - mountPath: /etc/auth-gateway
          name: config
          readOnly: true
      - args:
        - --config=/etc/collector/config.yaml
        image: otel/opentelemetry-collector-contrib:0.135.0
        imagePullPolicy: IfNotPresent
        name: metrics
        ports:
        - containerPort: 8889
          name: metrics
          protocol: TCP
        resources:
          limits:
            memory: 256Mi
          requests:
            cpu: 20m
            memory: 64Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
          runAsNonRoot: true
        volumeMounts:
        - mountPath: /etc/collector
          name: metrics-config
          readOnly: true
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      serviceAccountName: auth-gateway
      terminationGracePeriodSeconds: 30
      volumes:
      - configMap:
          items:
          - key: envoy.yaml
            path: envoy.yaml
          name: auth-gateway-config
        name: config
      - configMap:
          name: auth-gateway-metrics
        name: metrics-config
status: {}
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  name: auth-gateway
  namespace: observability
spec:
  ports:
  - name: http
    port: 80
    protocol: TCP
    targetPort: http
  - name: metrics
    port: 8889
    protocol: TCP
    targetPort: metrics
  selector:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  type: ClusterIP
status:
  loadBalancer: {}
