kind: ConfigMap
metadata:
  name: auth-gateway-config
  namespace: gateway-test
---
apiVersion: v1
data:
  config.yaml: |
    receivers:
      prometheus:
        config:
          scrape_configs:
            - job_name: auth-gateway
              scrape_interval: 30s
              scrape_timeout: 10s
              metrics_path: /stats/prometheus
              static_configs:
                - targets:
                    - 127.0.0.1:9901
    processors:
      transform:
        metric_statements:
          - context: metric
            statements:
              - replace_pattern(name, "^envoy_http_lua_", "")
    exporters:
      prometheus:
        endpoint: 0.0.0.0:8889
    service:
      pipelines:
        metrics:
          receivers:
            - prometheus
          processors:
            - transform
          exporters:
            - prometheus
kind: ConfigMap
metadata:
  name: auth-gateway-metrics
  namespace: gateway-test
---
apiVersion: v1
automountServiceAccountToken: false
kind: ServiceAccount
metadata:
  labels:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  name: auth-gateway
  namespace: gateway-test
---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  name: auth-gateway
  namespace: gateway-test
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/instance: auth-gateway
      app.kubernetes.io/name: auth-gateway
  strategy: {}
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: auth-gateway
        app.kubernetes.io/name: auth-gateway
    spec:
      automountServiceAccountToken: false
      containers:
      - args:
        - -c
        - /etc/auth-gateway/envoy.yaml
        - --log-level
        - info
        image: envoyproxy/envoy:v1.39.1
        imagePullPolicy: IfNotPresent
        lifecycle:
          preStop:
            exec:
              command:
              - /bin/sh
              - -c
              - sleep 5
        name: envoy
        ports:
        - containerPort: 8080
          name: http
          protocol: TCP
        - containerPort: 9901
          name: admin
          protocol: TCP
        readinessProbe:
          failureThreshold: 12
          periodSeconds: 5
          tcpSocket:
            port: http
        resources:
          limits:
            cpu: "1"
            memory: 256Mi
          requests:
            cpu: 50m
            memory: 64Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
          runAsGroup: 101
          runAsNonRoot: true
          runAsUser: 101
        volumeMounts:
        - mountPath: /etc/auth-gateway
          name: config
          readOnly: true
        - mountPath: /etc/auth-gateway/api-keys
          name: api-keys
          readOnly: true
      - args:
        - --config=/etc/collector/config.yaml
        image: otel/opentelemetry-collector-contrib:0.135.0
        imagePullPolicy: IfNotPresent
        name: metrics
        ports:
        - containerPort: 8889
          name: metrics
          protocol: TCP
        resources:
          limits:
            memory: 256Mi
          requests:
            cpu: 20m
            memory: 64Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
          runAsNonRoot: true
        volumeMounts:
        - mountPath: /etc/collector
          name: metrics-config
          readOnly: true
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      serviceAccountName: auth-gateway
      terminationGracePeriodSeconds: 30
      volumes:
      - configMap:
          items:
          - key: envoy.yaml
            path: envoy.yaml
          name: auth-gateway-config
        name: config
      - configMap:
          name: auth-gateway-metrics
        name: metrics-config
      - name: api-keys
        secret:
          items:
          - key: api-keys.yaml
            path: api-keys.yaml
          secretName: gateway-api-keys
status: {}
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  name: auth-gateway
  namespace: gateway-test
spec:
  ports:
  - name: http
    port: 80
    protocol: TCP
    targetPort: http
  - name: metrics
    port: 8889
    protocol: TCP
    targetPort: metrics
  selector:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  type: ClusterIP
status:
  loadBalancer: {}
