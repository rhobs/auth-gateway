apiVersion: v1
data:
  envoy.yaml: |
    # Generated by github.com/rhobs/auth-gateway.
    admin:
        address:
            socket_address:
                address: 127.0.0.1
                port_value: 9901
    node:
        cluster: auth-gateway
        id: auth-gateway
    static_resources:
        clusters:
            - circuit_breakers:
                thresholds:
                    - max_connections: 1024
                      max_pending_requests: 1024
                      max_requests: 1024
                      max_retries: 0
              connect_timeout: 5s
              load_assignment:
                cluster_name: api-ingest
                endpoints:
                    - lb_endpoints:
                        - endpoint:
                            address:
                                socket_address:
                                    address: httpbin
                                    port_value: 8080
              name: api-ingest
              per_connection_buffer_limit_bytes: 1048576
              type: STRICT_DNS
              typed_extension_protocol_options:
                envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
                    '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
                    explicit_http_config:
                        http_protocol_options: {}
            - circuit_breakers:
                thresholds:
                    - max_connections: 1024
                      max_pending_requests: 1024
                      max_requests: 1024
                      max_retries: 0
              connect_timeout: 5s
              load_assignment:
                cluster_name: api-public
                endpoints:
                    - lb_endpoints:
                        - endpoint:
                            address:
                                socket_address:
                                    address: httpbin
                                    port_value: 8080
              name: api-public
              per_connection_buffer_limit_bytes: 1048576
              type: STRICT_DNS
              typed_extension_protocol_options:
                envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
                    '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
                    explicit_http_config:
                        http_protocol_options: {}
            - circuit_breakers:
                thresholds:
                    - max_connections: 1024
                      max_pending_requests: 1024
                      max_requests: 1024
                      max_retries: 0
              connect_timeout: 5s
              dns_lookup_family: V4_ONLY
              load_assignment:
                cluster_name: jwks-issuer-one
                endpoints:
                    - lb_endpoints:
                        - endpoint:
                            address:
                                socket_address:
                                    address: jwks.jwt.test
                                    port_value: 443
              name: jwks-issuer-one
              transport_socket:
                name: envoy.transport_sockets.tls
                typed_config:
                    '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
                    common_tls_context:
                        tls_params:
                            tls_maximum_protocol_version: TLSv1_3
                            tls_minimum_protocol_version: TLSv1_2
                        validation_context:
                            match_typed_subject_alt_names:
                                - matcher:
                                    exact: jwks.jwt.test
                                  san_type: DNS
                            trusted_ca:
                                filename: /etc/ssl/certs/ca-certificates.crt
                    sni: jwks.jwt.test
              type: STRICT_DNS
        listeners:
            - address:
                socket_address:
                    address: 0.0.0.0
                    port_value: 8080
              filter_chains:
                - filters:
                    - name: envoy.filters.network.http_connection_manager
                      typed_config:
                        '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                        access_log:
                            - filter:
                                status_code_filter:
                                    comparison:
                                        op: GE
                                        value:
                                            default_value: 400
                              name: envoy.access_loggers.stdout
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                                log_format:
                                    json_format:
                                        bytes_received: '%BYTES_RECEIVED%'
                                        bytes_sent: '%BYTES_SENT%'
                                        connection_termination: '%CONNECTION_TERMINATION_DETAILS%'
                                        duration_ms: '%DURATION%'
                                        method: '%REQ(:METHOD)%'
                                        path: '%PATH(NQ)%'
                                        request_id: '%REQ(X-REQUEST-ID)%'
                                        response_code_details: '%RESPONSE_CODE_DETAILS%'
                                        response_flags: '%RESPONSE_FLAGS%'
                                        route: '%ROUTE_NAME%'
                                        status: '%RESPONSE_CODE%'
                                        timestamp: '%START_TIME%'
                                        upstream_cluster: '%UPSTREAM_CLUSTER%'
                                        upstream_host: '%UPSTREAM_HOST%'
                                        upstream_transport_failure: '%UPSTREAM_TRANSPORT_FAILURE_REASON%'
                        common_http_protocol_options:
                            headers_with_underscores_action: REJECT_REQUEST
                            idle_timeout: 60s
                            max_headers_count: 100
                            max_stream_duration: 30s
                        http_filters:
                            - name: auth_gateway.request_controls
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: x-envoy-original-path
                                        - remove: x-envoy-retry-on
                                        - remove: x-envoy-retry-grpc-on
                                        - remove: x-envoy-max-retries
                                        - remove: x-envoy-hedge-on-per-try-timeout
                                        - remove: x-envoy-upstream-rq-timeout-ms
                                        - remove: x-envoy-upstream-rq-per-try-timeout-ms
                                        - remove: x-envoy-expected-rq-timeout-ms
                                        - remove: x-envoy-upstream-alt-stat-name
                                        - remove: x-envoy-upstream-stream-duration-ms
                                        - remove: x-envoy-upstream-rq-timeout-alt-response
                                        - remove: x-envoy-retriable-status-codes
                                        - remove: x-envoy-retriable-header-names
                                        - remove: x-auth-gateway-request-validation-pending
                                        - remove: x-auth-gateway-api-key-client
                                        - remove: x-auth-gateway-mtls-fingerprint
                                        - remove: x-auth-gateway-mtls-uri-san
                                        - remove: x-auth-gateway-mtls-dns-san
                            - name: envoy.filters.http.lua
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
                                default_source_code:
                                    inline_string: |
                                        local labels = {"tenant", "writer"}
                                        local counter_name = "gateway_http_requests_total"

                                        local function safe_label(value)
                                          if type(value) ~= "string" or #value == 0 or #value > 128 then
                                            return "__unattributed__"
                                          end
                                          for i = 1, #value do
                                            local byte = string.byte(value, i)
                                            if byte < 32 or byte > 126 or byte == 124 then
                                              return "__unattributed__"
                                            end
                                          end
                                          return value
                                        end

                                        function envoy_on_response(response_handle)
                                          local metadata = response_handle:metadata()
                                          if metadata == nil then
                                            return
                                          end
                                          local api = metadata:get("api")
                                          if type(api) ~= "string" or api == "" then
                                            return
                                          end
                                          local status = response_handle:headers():get(":status")
                                          if type(status) ~= "string" or not string.match(status, "^%d%d%d$") then
                                            return
                                          end

                                          local bindings = metadata:get("labels") or {}
                                          local filter_state = response_handle:streamInfo():filterState()
                                          local name = counter_name .. "|api=" .. api .. "|http_status_code=" .. status
                                          for _, label in ipairs(labels) do
                                            local attribute = bindings[label]
                                            local value = nil
                                            if type(attribute) == "string" then
                                              value = filter_state:get("auth_gateway.attributes." .. attribute)
                                            end
                                            name = name .. "|" .. label .. "=" .. safe_label(value)
                                          end
                                          response_handle:stats():counter(name):inc()
                                        end
                            - name: auth_gateway.request_validation.begin
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - append:
                                            append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                            header:
                                                key: x-auth-gateway-request-validation-pending
                                                value: "true"
                            - name: auth_gateway.request_validation
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                            - name: auth_gateway.request_validation.complete
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: x-auth-gateway-request-validation-pending
                            - name: envoy.filters.http.jwt_authn
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication
                                providers:
                                    issuer-one:
                                        audiences:
                                            - gateway-test
                                        from_headers:
                                            - name: Authorization
                                              value_prefix: 'Bearer '
                                        issuer: https://issuer-one.jwt.test
                                        payload_in_metadata: issuer-one
                                        remote_jwks:
                                            cache_duration: 300s
                                            http_uri:
                                                cluster: jwks-issuer-one
                                                timeout: 5s
                                                uri: https://jwks.jwt.test/issuer-one
                                        require_expiration: true
                                requirement_map:
                                    server-2-api-0-access-0:
                                        provider_name: issuer-one
                                strip_failure_response: true
                            - config_discovery:
                                config_source:
                                    path_config_source:
                                        path: /etc/auth-gateway/api-keys/api-keys.yaml
                                        watched_directory:
                                            path: /etc/auth-gateway/api-keys
                                    resource_api_version: V3
                                type_urls:
                                    - envoy.extensions.filters.http.api_key_auth.v3.ApiKeyAuth
                              disabled: true
                              name: envoy.filters.http.api_key_auth
                            - name: envoy.filters.http.header_to_metadata
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_to_metadata.v3.Config
                                request_rules:
                                    - header: x-auth-gateway-api-key-client
                                      on_header_present:
                                        key: identity
                                        metadata_namespace: auth_gateway.api_key
                                        value: verified
                                    - header: x-auth-gateway-api-key-client
                                      on_header_present:
                                        key: attribute.tenant_id
                                        metadata_namespace: auth_gateway.api_key
                                        regex_value_rewrite:
                                            pattern:
                                                regex: ^(?:(?:[^;]*;)*tenant_id=([^;]*)(?:;[^;]*)*|.*)$
                                            substitution: \1
                                    - header: x-auth-gateway-api-key-client
                                      on_header_present:
                                        key: attribute.writer_id
                                        metadata_namespace: auth_gateway.api_key
                                        regex_value_rewrite:
                                            pattern:
                                                regex: ^(?:(?:[^;]*;)*writer_id=([^;]*)(?:;[^;]*)*|.*)$
                                            substitution: \1
                                      remove: true
                            - disabled: true
                              name: envoy.filters.http.set_filter_state
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                            - name: envoy.filters.http.rbac
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                                rules: {}
                            - name: auth_gateway.required_headers
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                            - name: auth_gateway.credentials
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: authorization
                                        - remove: x-auth-gateway-api-key-client
                                        - remove: x-auth-gateway-request-validation-pending
                                        - remove: x-partner-key
                            - name: envoy.filters.http.header_mutation
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: x-scope-orgid
                                        - remove: x-writer-id
                            - name: envoy.filters.http.router
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                        local_reply_config:
                            mappers:
                                - filter:
                                    and_filter:
                                        filters:
                                            - status_code_filter:
                                                comparison:
                                                    value:
                                                        default_value: 403
                                            - header_filter:
                                                header:
                                                    name: x-auth-gateway-request-validation-pending
                                                    string_match:
                                                        exact: "true"
                                  status_code: 400
                        max_request_headers_kb: 32
                        normalize_path: true
                        path_with_escaped_slashes_action: UNESCAPE_AND_FORWARD
                        request_headers_timeout: 5s
                        request_timeout: 30s
                        route_config:
                            ignore_port_in_host_matching: true
                            name: ingestion
                            virtual_hosts:
                                - domains:
                                    - public.gateway.test
                                  name: public.gateway.test
                                  routes:
                                    - match:
                                        headers:
                                            - name: :method
                                              string_match:
                                                exact: GET
                                        path: /health
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: public
                                      name: api-0-public-route-0-method-0
                                      route:
                                        cluster: api-public
                                        idle_timeout: 60s
                                        max_stream_duration:
                                            max_stream_duration: 30s
                                        path_rewrite: /anything
                                        timeout: 30s
                                      stat_prefix: api-0-public-route-0-method-0
                                      typed_per_filter_config:
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                    - direct_response:
                                        status: 405
                                      match:
                                        path: /health
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: __local
                                      name: method-not-allowed-0
                                      response_headers_to_add:
                                        - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                          header:
                                            key: allow
                                            value: GET
                                      typed_per_filter_config:
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                    - direct_response:
                                        status: 404
                                      match:
                                        prefix: /
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: __local
                                      name: not-found
                                      typed_per_filter_config:
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                  typed_per_filter_config:
                                    envoy.filters.http.jwt_authn:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                                        disabled: true
                                    envoy.filters.http.rbac:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                - domains:
                                    - key.gateway.test
                                  name: key.gateway.test
                                  routes:
                                    - match:
                                        headers:
                                            - name: :method
                                              string_match:
                                                exact: POST
                                        path: /ingest
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.lua:
                                                api: ingest
                                                labels:
                                                    tenant: tenant_id
                                                    writer: writer_id
                                            envoy.filters.http.rbac:
                                                api: ingest
                                      name: api-0-ingest-route-0-method-0-access-0-match-0
                                      route:
                                        cluster: api-ingest
                                        idle_timeout: 60s
                                        max_stream_duration:
                                            max_stream_duration: 30s
                                        path_rewrite: /anything
                                        timeout: 30s
                                      stat_prefix: api-0-ingest-route-0-method-0-access-0-match-0
                                      typed_per_filter_config:
                                        auth_gateway.request_validation:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                            rbac:
                                                rules:
                                                    action: DENY
                                                    policies:
                                                        invalid-request-headers:
                                                            condition:
                                                                call_expr:
                                                                    args:
                                                                        - call_expr:
                                                                            args:
                                                                                - const_expr:
                                                                                    string_value: x-partner-key
                                                                                  id: "3"
                                                                                - id: "2"
                                                                                  select_expr:
                                                                                    field: headers
                                                                                    operand:
                                                                                        id: "1"
                                                                                        ident_expr:
                                                                                            name: request
                                                                            function: '@in'
                                                                          id: "4"
                                                                        - call_expr:
                                                                            args:
                                                                                - const_expr:
                                                                                    string_value: ','
                                                                                  id: "7"
                                                                            function: contains
                                                                            target:
                                                                                call_expr:
                                                                                    args:
                                                                                        - id: "2"
                                                                                          select_expr:
                                                                                            field: headers
                                                                                            operand:
                                                                                                id: "1"
                                                                                                ident_expr:
                                                                                                    name: request
                                                                                        - const_expr:
                                                                                            string_value: x-partner-key
                                                                                          id: "3"
                                                                                    function: _[_]
                                                                                id: "5"
                                                                          id: "6"
                                                                    function: _&&_
                                                                id: "8"
                                                            permissions:
                                                                - any: true
                                                            principals:
                                                                - any: true
                                        auth_gateway.required_headers:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                            rbac:
                                                rules:
                                                    policies:
                                                        required-attributes:
                                                            permissions:
                                                                - any: true
                                                            principals:
                                                                - and_ids:
                                                                    ids:
                                                                        - filter_state:
                                                                            key: auth_gateway.attributes.tenant_id
                                                                            string_match:
                                                                                safe_regex:
                                                                                    regex: ^[^\x00-\x1f\x7f]+$
                                                                        - filter_state:
                                                                            key: auth_gateway.attributes.writer_id
                                                                            string_match:
                                                                                safe_regex:
                                                                                    regex: ^[^\x00-\x1f\x7f]+$
                                        envoy.filters.http.api_key_auth:
                                            '@type': type.googleapis.com/envoy.config.route.v3.FilterConfig
                                            config:
                                                '@type': type.googleapis.com/envoy.extensions.filters.http.api_key_auth.v3.ApiKeyAuthPerRoute
                                                forwarding:
                                                    header: x-auth-gateway-api-key-client
                                                    hide_credentials: true
                                        envoy.filters.http.header_mutation:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutationPerRoute
                                            mutations:
                                                request_mutations:
                                                    - append:
                                                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                                        header:
                                                            key: X-Scope-OrgID
                                                            value: '%FILTER_STATE(auth_gateway.attributes.tenant_id:PLAIN)%'
                                                    - append:
                                                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                                        header:
                                                            key: X-Writer-ID
                                                            value: '%FILTER_STATE(auth_gateway.attributes.writer_id:PLAIN)%'
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                            rbac:
                                                rules:
                                                    policies:
                                                        grant-0:
                                                            permissions:
                                                                - any: true
                                                            principals:
                                                                - and_ids:
                                                                    ids:
                                                                        - sourced_metadata:
                                                                            metadata_matcher:
                                                                                filter: auth_gateway.api_key
                                                                                path:
                                                                                    - key: identity
                                                                                value:
                                                                                    string_match:
                                                                                        exact: verified
                                                                        - sourced_metadata:
                                                                            metadata_matcher:
                                                                                filter: auth_gateway.api_key
                                                                                path:
                                                                                    - key: attribute.tenant_id
                                                                                value:
                                                                                    string_match:
                                                                                        exact: client-a
                                        envoy.filters.http.set_filter_state:
                                            '@type': type.googleapis.com/envoy.config.route.v3.FilterConfig
                                            config:
                                                '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                                                on_request_headers:
                                                    - factory_key: envoy.string
                                                      format_string:
                                                        omit_empty_values: true
                                                        text_format_source:
                                                            inline_string: '%CEL((("auth_gateway.api_key" in metadata.filter_metadata && "attribute.tenant_id" in metadata.filter_metadata["auth_gateway.api_key"]) && type(metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"] != "") ? metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"] : "")%'
                                                      object_key: auth_gateway.attributes.tenant_id
                                                      skip_if_empty: true
                                                    - factory_key: envoy.string
                                                      format_string:
                                                        omit_empty_values: true
                                                        text_format_source:
                                                            inline_string: '%CEL((("auth_gateway.api_key" in metadata.filter_metadata && "attribute.writer_id" in metadata.filter_metadata["auth_gateway.api_key"]) && type(metadata.filter_metadata["auth_gateway.api_key"]["attribute.writer_id"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["attribute.writer_id"] != "") ? metadata.filter_metadata["auth_gateway.api_key"]["attribute.writer_id"] : "")%'
                                                      object_key: auth_gateway.attributes.writer_id
                                                      skip_if_empty: true
                                    - direct_response:
                                        status: 403
                                      match:
                                        headers:
                                            - name: :method
                                              string_match:
                                                exact: POST
                                        path: /ingest
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.lua:
                                                api: ingest
                                                labels:
                                                    tenant: tenant_id
                                                    writer: writer_id
                                            envoy.filters.http.rbac:
                                                api: ingest
                                      name: api-0-ingest-route-0-method-0-access-denied
                                      stat_prefix: api-0-ingest-route-0-method-0-access-denied
                                      typed_per_filter_config:
                                        auth_gateway.request_validation:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                    - direct_response:
                                        status: 405
                                      match:
                                        path: /ingest
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: __local
                                      name: method-not-allowed-0
                                      response_headers_to_add:
                                        - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                          header:
                                            key: allow
                                            value: POST
                                      typed_per_filter_config:
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                    - direct_response:
                                        status: 404
                                      match:
                                        prefix: /
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: __local
                                      name: not-found
                                      typed_per_filter_config:
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                  typed_per_filter_config:
                                    envoy.filters.http.jwt_authn:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                                        disabled: true
                                    envoy.filters.http.rbac:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        rbac:
                                            rules: {}
                                - domains:
                                    - mixed.gateway.test
                                  name: mixed.gateway.test
                                  routes:
                                    - match:
                                        headers:
                                            - name: :method
                                              string_match:
                                                exact: POST
                                            - name: x-auth-path
                                              string_match:
                                                exact: jwt
                                        path: /ingest
                                      metadata:
                                        filter_metadata:
