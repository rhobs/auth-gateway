apiVersion: v1
data:
  envoy.yaml: |
    # Generated by github.com/rhobs/auth-gateway.
    admin:
        address:
            socket_address:
                address: 127.0.0.1
                port_value: 9901
    node:
        cluster: auth-gateway
        id: auth-gateway
    static_resources:
        clusters:
            - circuit_breakers:
                thresholds:
                    - max_connections: 1024
                      max_pending_requests: 1024
                      max_requests: 1024
                      max_retries: 0
              connect_timeout: 5s
              load_assignment:
                cluster_name: api-metrics
                endpoints:
                    - lb_endpoints:
                        - endpoint:
                            address:
                                socket_address:
                                    address: thanos-receive
                                    port_value: 19291
              name: api-metrics
              per_connection_buffer_limit_bytes: 1048576
              type: STRICT_DNS
              typed_extension_protocol_options:
                envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
                    '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
                    explicit_http_config:
                        http_protocol_options: {}
            - circuit_breakers:
                thresholds:
                    - max_connections: 1024
                      max_pending_requests: 1024
                      max_requests: 1024
                      max_retries: 0
              connect_timeout: 5s
              dns_lookup_family: V4_ONLY
              load_assignment:
                cluster_name: jwks-internal-jwt
                endpoints:
                    - lb_endpoints:
                        - endpoint:
                            address:
                                socket_address:
                                    address: issuer.example.test
                                    port_value: 443
              name: jwks-internal-jwt
              transport_socket:
                name: envoy.transport_sockets.tls
                typed_config:
                    '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
                    common_tls_context:
                        tls_params:
                            tls_maximum_protocol_version: TLSv1_3
                            tls_minimum_protocol_version: TLSv1_2
                        validation_context:
                            match_typed_subject_alt_names:
                                - matcher:
                                    exact: issuer.example.test
                                  san_type: DNS
                            trusted_ca:
                                filename: /etc/ssl/certs/ca-certificates.crt
                    sni: issuer.example.test
              type: STRICT_DNS
            - circuit_breakers:
                thresholds:
                    - max_connections: 1024
                      max_pending_requests: 1024
                      max_requests: 1024
                      max_retries: 0
              connect_timeout: 5s
              load_assignment:
                cluster_name: ext-authz-policy
                endpoints:
                    - lb_endpoints:
                        - endpoint:
                            address:
                                socket_address:
                                    address: policy.example.test
                                    port_value: 9000
              name: ext-authz-policy
              per_connection_buffer_limit_bytes: 1048576
              transport_socket:
                name: envoy.transport_sockets.tls
                typed_config:
                    '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
                    common_tls_context:
                        alpn_protocols:
                            - h2
                        tls_params:
                            tls_maximum_protocol_version: TLSv1_3
                            tls_minimum_protocol_version: TLSv1_2
                        validation_context:
                            match_typed_subject_alt_names:
                                - matcher:
                                    exact: policy.example.test
                                  san_type: DNS
                            trusted_ca:
                                filename: /etc/ssl/certs/ca-certificates.crt
                    sni: policy.example.test
              type: STRICT_DNS
              typed_extension_protocol_options:
                envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
                    '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
                    explicit_http_config:
                        http2_protocol_options: {}
        listeners:
            - address:
                socket_address:
                    address: 0.0.0.0
                    port_value: 8080
              filter_chains:
                - filters:
                    - name: envoy.filters.network.http_connection_manager
                      typed_config:
                        '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                        access_log:
                            - filter:
                                status_code_filter:
                                    comparison:
                                        op: GE
                                        value:
                                            default_value: 400
                              name: envoy.access_loggers.stdout
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                                log_format:
                                    json_format:
                                        bytes_received: '%BYTES_RECEIVED%'
                                        bytes_sent: '%BYTES_SENT%'
                                        connection_termination: '%CONNECTION_TERMINATION_DETAILS%'
                                        duration_ms: '%DURATION%'
                                        method: '%REQ(:METHOD)%'
                                        path: '%PATH(NQ)%'
                                        request_id: '%REQ(X-REQUEST-ID)%'
                                        response_code_details: '%RESPONSE_CODE_DETAILS%'
                                        response_flags: '%RESPONSE_FLAGS%'
                                        route: '%ROUTE_NAME%'
                                        status: '%RESPONSE_CODE%'
                                        timestamp: '%START_TIME%'
                                        upstream_cluster: '%UPSTREAM_CLUSTER%'
                                        upstream_host: '%UPSTREAM_HOST%'
                                        upstream_transport_failure: '%UPSTREAM_TRANSPORT_FAILURE_REASON%'
                        common_http_protocol_options:
                            headers_with_underscores_action: REJECT_REQUEST
                            idle_timeout: 60s
                            max_headers_count: 100
                            max_stream_duration: 30s
                        http_filters:
                            - name: auth_gateway.request_controls
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: x-envoy-original-path
                                        - remove: x-envoy-retry-on
                                        - remove: x-envoy-retry-grpc-on
                                        - remove: x-envoy-max-retries
                                        - remove: x-envoy-hedge-on-per-try-timeout
                                        - remove: x-envoy-upstream-rq-timeout-ms
                                        - remove: x-envoy-upstream-rq-per-try-timeout-ms
                                        - remove: x-envoy-expected-rq-timeout-ms
                                        - remove: x-envoy-upstream-alt-stat-name
                                        - remove: x-envoy-upstream-stream-duration-ms
                                        - remove: x-envoy-upstream-rq-timeout-alt-response
                                        - remove: x-envoy-retriable-status-codes
                                        - remove: x-envoy-retriable-header-names
                                        - remove: x-auth-gateway-request-validation-pending
                                        - remove: x-auth-gateway-api-key-client
                                        - remove: x-auth-gateway-mtls-fingerprint
                                        - remove: x-auth-gateway-mtls-uri-san
                                        - remove: x-auth-gateway-mtls-dns-san
                            - name: auth_gateway.request_validation.begin
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - append:
                                            append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                            header:
                                                key: x-auth-gateway-request-validation-pending
                                                value: "true"
                            - name: auth_gateway.request_validation
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                            - name: auth_gateway.request_validation.complete
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: x-auth-gateway-request-validation-pending
                            - name: envoy.filters.http.jwt_authn
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication
                                providers:
                                    internal-jwt:
                                        from_headers:
                                            - name: Authorization
                                              value_prefix: 'Bearer '
                                        issuer: https://issuer.example.test
                                        payload_in_metadata: internal-jwt
                                        remote_jwks:
                                            cache_duration: 300s
                                            http_uri:
                                                cluster: jwks-internal-jwt
                                                timeout: 5s
                                                uri: https://issuer.example.test/jwks
                                        require_expiration: true
                                requirement_map:
                                    server-0-api-0-access-0:
                                        provider_name: internal-jwt
                                strip_failure_response: true
                            - name: envoy.filters.http.header_to_metadata
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_to_metadata.v3.Config
                                request_rules:
                                    - header: x-tenant
                                      on_header_present:
                                        key: x-tenant
                                        metadata_namespace: auth_gateway.request_headers
                            - disabled: true
                              name: envoy.filters.http.set_filter_state
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                            - name: envoy.filters.http.rbac
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                                rules: {}
                            - name: auth_gateway.ext_authz.attribute_bridge
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
                                clear_route_cache: false
                                default_source_code:
                                    inline_string: function envoy_on_request(handle) end
                            - disabled: true
                              name: auth_gateway.ext_authz.policy
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthz
                                allowed_headers:
                                    patterns:
                                        - exact: authorization
                                        - exact: x-tenant
                                decoder_header_mutation_rules:
                                    disallow_all: true
                                    disallow_is_error: true
                                grpc_service:
                                    envoy_grpc:
                                        cluster_name: ext-authz-policy
                                    timeout: 0.300s
                                metadata_context_namespaces:
                                    - auth_gateway.ext_authz.attributes
                                    - envoy.filters.http.jwt_authn
                                route_metadata_context_namespaces:
                                    - auth_gateway.ext_authz.access
                                status_on_error:
                                    code: ServiceUnavailable
                                transport_api_version: V3
                                validate_mutations: true
                            - name: auth_gateway.required_headers
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                            - name: auth_gateway.credentials
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: authorization
                                        - remove: x-auth-gateway-api-key-client
                                        - remove: x-auth-gateway-request-validation-pending
                            - name: auth_gateway.ext_authz.credentials
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            - name: envoy.filters.http.header_mutation
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: x-scope-orgid
                            - name: envoy.filters.http.router
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                        local_reply_config:
                            mappers:
                                - filter:
                                    and_filter:
                                        filters:
                                            - status_code_filter:
                                                comparison:
                                                    value:
                                                        default_value: 403
                                            - header_filter:
                                                header:
                                                    name: x-auth-gateway-request-validation-pending
                                                    string_match:
                                                        exact: "true"
                                  status_code: 400
                        max_request_headers_kb: 32
                        normalize_path: true
                        path_with_escaped_slashes_action: UNESCAPE_AND_FORWARD
                        request_headers_timeout: 5s
                        request_timeout: 30s
                        route_config:
                            ignore_port_in_host_matching: true
                            name: ingestion
                            virtual_hosts:
                                - domains:
                                    - writer.example.test
                                  name: writer.example.test
                                  routes:
                                    - match:
                                        headers:
                                            - name: :method
                                              string_match:
                                                exact: GET
                                            - name: x-tenant
                                              string_match:
                                                exact: internal
                                        path: /protected
                                      metadata:
                                        filter_metadata:
                                            auth_gateway.ext_authz.access:
                                                access: jwt
                                                api: metrics
                                            envoy.filters.http.rbac:
                                                api: metrics
                                      name: api-0-metrics-route-0-method-0-access-0-match-0
                                      route:
                                        cluster: api-metrics
                                        idle_timeout: 60s
                                        max_stream_duration:
                                            max_stream_duration: 30s
                                        path_rewrite: /anything
                                        timeout: 30s
                                      stat_prefix: api-0-metrics-route-0-method-0-access-0-match-0
                                      typed_per_filter_config:
                                        auth_gateway.ext_authz.attribute_bridge:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.lua.v3.LuaPerRoute
                                            source_code:
                                                inline_string: |
                                                    function envoy_on_request(handle)
                                                      local state = handle:streamInfo():filterState()
                                                      local metadata = handle:streamInfo():dynamicMetadata()
                                                      do
                                                        local value = state:get("auth_gateway.attributes.requested_tenant")
                                                        if value ~= nil and value ~= "" then
                                                          metadata:set("auth_gateway.ext_authz.attributes", "requested_tenant", value)
                                                        end
                                                      end
                                                      do
                                                        local value = state:get("auth_gateway.attributes.tenant_id")
                                                        if value ~= nil and value ~= "" then
                                                          metadata:set("auth_gateway.ext_authz.attributes", "tenant_id", value)
                                                        end
                                                      end
                                                    end
                                        auth_gateway.ext_authz.credentials:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutationPerRoute
                                            mutations:
                                                request_mutations:
                                                    - remove: authorization
                                        auth_gateway.ext_authz.policy:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthzPerRoute
                                            disabled: false
                                        auth_gateway.request_validation:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                            rbac:
                                                rules:
                                                    action: DENY
                                                    policies:
                                                        invalid-request-headers:
                                                            condition:
                                                                call_expr:
                                                                    args:
                                                                        - call_expr:
                                                                            args:
                                                                                - call_expr:
                                                                                    args:
                                                                                        - const_expr:
                                                                                            string_value: x-tenant
                                                                                          id: "3"
                                                                                        - id: "2"
                                                                                          select_expr:
                                                                                            field: headers
                                                                                            operand:
                                                                                                id: "1"
                                                                                                ident_expr:
                                                                                                    name: request
                                                                                    function: '@in'
                                                                                  id: "4"
                                                                                - call_expr:
                                                                                    args:
                                                                                        - const_expr:
                                                                                            string_value: ','
                                                                                          id: "7"
                                                                                    function: contains
                                                                                    target:
                                                                                        call_expr:
                                                                                            args:
                                                                                                - id: "2"
                                                                                                  select_expr:
                                                                                                    field: headers
                                                                                                    operand:
                                                                                                        id: "1"
                                                                                                        ident_expr:
                                                                                                            name: request
                                                                                                - const_expr:
                                                                                                    string_value: x-tenant
                                                                                                  id: "3"
                                                                                            function: _[_]
                                                                                        id: "5"
                                                                                  id: "6"
                                                                            function: _&&_
                                                                          id: "8"
                                                                        - call_expr:
                                                                            args:
                                                                                - call_expr:
                                                                                    args:
                                                                                        - const_expr:
                                                                                            string_value: authorization
                                                                                          id: "11"
                                                                                        - id: "10"
                                                                                          select_expr:
                                                                                            field: headers
                                                                                            operand:
                                                                                                id: "9"
                                                                                                ident_expr:
                                                                                                    name: request
                                                                                    function: '@in'
                                                                                  id: "12"
                                                                                - call_expr:
                                                                                    args:
                                                                                        - const_expr:
                                                                                            string_value: ','
                                                                                          id: "15"
                                                                                    function: contains
                                                                                    target:
                                                                                        call_expr:
                                                                                            args:
                                                                                                - id: "10"
                                                                                                  select_expr:
                                                                                                    field: headers
                                                                                                    operand:
                                                                                                        id: "9"
                                                                                                        ident_expr:
                                                                                                            name: request
                                                                                                - const_expr:
                                                                                                    string_value: authorization
                                                                                                  id: "11"
                                                                                            function: _[_]
                                                                                        id: "13"
                                                                                  id: "14"
                                                                            function: _&&_
                                                                          id: "16"
                                                                    function: _||_
                                                                id: "17"
                                                            permissions:
                                                                - any: true
                                                            principals:
                                                                - any: true
                                        auth_gateway.required_headers:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                            rbac:
                                                rules:
                                                    policies:
                                                        required-attributes:
                                                            permissions:
                                                                - any: true
                                                            principals:
                                                                - filter_state:
                                                                    key: auth_gateway.attributes.requested_tenant
                                                                    string_match:
                                                                        safe_regex:
                                                                            regex: ^[^\x00-\x1f\x7f]+$
                                        envoy.filters.http.header_mutation:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutationPerRoute
                                            mutations:
                                                request_mutations:
                                                    - append:
                                                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                                        header:
                                                            key: X-Scope-OrgID
                                                            value: '%FILTER_STATE(auth_gateway.attributes.requested_tenant:PLAIN)%'
                                        envoy.filters.http.jwt_authn:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                                            requirement_name: server-0-api-0-access-0
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        envoy.filters.http.set_filter_state:
                                            '@type': type.googleapis.com/envoy.config.route.v3.FilterConfig
                                            config:
                                                '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                                                on_request_headers:
                                                    - factory_key: envoy.string
                                                      format_string:
                                                        omit_empty_values: true
                                                        text_format_source:
                                                            inline_string: '%CEL((("internal-jwt" in metadata.filter_metadata["envoy.filters.http.jwt_authn"] && "tenant" in metadata.filter_metadata["envoy.filters.http.jwt_authn"]["internal-jwt"]) && type(metadata.filter_metadata["envoy.filters.http.jwt_authn"]["internal-jwt"]["tenant"]) == string && metadata.filter_metadata["envoy.filters.http.jwt_authn"]["internal-jwt"]["tenant"] != "") ? metadata.filter_metadata["envoy.filters.http.jwt_authn"]["internal-jwt"]["tenant"] : "")%'
                                                      object_key: auth_gateway.attributes.tenant_id
                                                      skip_if_empty: true
                                                    - factory_key: envoy.string
                                                      format_string:
                                                        omit_empty_values: true
                                                        text_format_source:
                                                            inline_string: '%CEL((("auth_gateway.request_headers" in metadata.filter_metadata && "x-tenant" in metadata.filter_metadata["auth_gateway.request_headers"] && type(metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"]) == string && metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] != "") ? metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] : ""))%'
                                                      object_key: auth_gateway.attributes.requested_tenant
                                                      skip_if_empty: true
                                    - match:
                                        headers:
                                            - name: :method
                                              string_match:
                                                exact: GET
                                            - name: x-tenant
                                              string_match:
                                                exact: partner
                                        path: /protected
                                      metadata:
                                        filter_metadata:
                                            auth_gateway.ext_authz.access:
                                                access: external
                                                api: metrics
                                            envoy.filters.http.rbac:
                                                api: metrics
                                      name: api-0-metrics-route-0-method-0-access-1-match-0
                                      route:
                                        cluster: api-metrics
                                        idle_timeout: 60s
                                        max_stream_duration:
                                            max_stream_duration: 30s
                                        path_rewrite: /anything
                                        timeout: 30s
                                      stat_prefix: api-0-metrics-route-0-method-0-access-1-match-0
                                      typed_per_filter_config:
                                        auth_gateway.ext_authz.attribute_bridge:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.lua.v3.LuaPerRoute
                                            source_code:
                                                inline_string: |
                                                    function envoy_on_request(handle)
                                                      local state = handle:streamInfo():filterState()
                                                      local metadata = handle:streamInfo():dynamicMetadata()
                                                      do
                                                        local value = state:get("auth_gateway.attributes.requested_tenant")
                                                        if value ~= nil and value ~= "" then
                                                          metadata:set("auth_gateway.ext_authz.attributes", "requested_tenant", value)
                                                        end
                                                      end
                                                      do
                                                        local value = state:get("auth_gateway.attributes.tenant_id")
                                                        if value ~= nil and value ~= "" then
                                                          metadata:set("auth_gateway.ext_authz.attributes", "tenant_id", value)
                                                        end
                                                      end
                                                    end
                                        auth_gateway.ext_authz.credentials:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutationPerRoute
                                            mutations:
                                                request_mutations:
                                                    - remove: authorization
                                        auth_gateway.ext_authz.policy:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.ext_authz.v3.ExtAuthzPerRoute
                                            disabled: false
                                        auth_gateway.request_validation:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                            rbac:
                                                rules:
                                                    action: DENY
                                                    policies:
                                                        invalid-request-headers:
                                                            condition:
                                                                call_expr:
                                                                    args:
                                                                        - call_expr:
                                                                            args:
                                                                                - call_expr:
                                                                                    args:
                                                                                        - const_expr:
                                                                                            string_value: x-tenant
                                                                                          id: "3"
                                                                                        - id: "2"
                                                                                          select_expr:
                                                                                            field: headers
                                                                                            operand:
                                                                                                id: "1"
                                                                                                ident_expr:
                                                                                                    name: request
                                                                                    function: '@in'
                                                                                  id: "4"
                                                                                - call_expr:
                                                                                    args:
                                                                                        - const_expr:
                                                                                            string_value: ','
                                                                                          id: "7"
                                                                                    function: contains
                                                                                    target:
                                                                                        call_expr:
                                                                                            args:
                                                                                                - id: "2"
                                                                                                  select_expr:
                                                                                                    field: headers
                                                                                                    operand:
                                                                                                        id: "1"
                                                                                                        ident_expr:
                                                                                                            name: request
                                                                                                - const_expr:
                                                                                                    string_value: x-tenant
                                                                                                  id: "3"
                                                                                            function: _[_]
                                                                                        id: "5"
                                                                                  id: "6"
                                                                            function: _&&_
                                                                          id: "8"
                                                                        - call_expr:
                                                                            args:
                                                                                - call_expr:
                                                                                    args:
                                                                                        - const_expr:
                                                                                            string_value: authorization
                                                                                          id: "11"
                                                                                        - id: "10"
                                                                                          select_expr:
                                                                                            field: headers
                                                                                            operand:
                                                                                                id: "9"
                                                                                                ident_expr:
                                                                                                    name: request
                                                                                    function: '@in'
                                                                                  id: "12"
                                                                                - call_expr:
                                                                                    args:
                                                                                        - const_expr:
                                                                                            string_value: ','
                                                                                          id: "15"
                                                                                    function: contains
                                                                                    target:
                                                                                        call_expr:
                                                                                            args:
                                                                                                - id: "10"
                                                                                                  select_expr:
                                                                                                    field: headers
                                                                                                    operand:
                                                                                                        id: "9"
                                                                                                        ident_expr:
                                                                                                            name: request
                                                                                                - const_expr:
                                                                                                    string_value: authorization
                                                                                                  id: "11"
                                                                                            function: _[_]
                                                                                        id: "13"
                                                                                  id: "14"
                                                                            function: _&&_
                                                                          id: "16"
                                                                    function: _||_
                                                                id: "17"
                                                            permissions:
                                                                - any: true
                                                            principals:
                                                                - any: true
                                        auth_gateway.required_headers:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                            rbac:
                                                rules:
                                                    policies:
                                                        required-attributes:
                                                            permissions:
                                                                - any: true
                                                            principals:
                                                                - filter_state:
                                                                    key: auth_gateway.attributes.requested_tenant
                                                                    string_match:
                                                                        safe_regex:
                                                                            regex: ^[^\x00-\x1f\x7f]+$
                                        envoy.filters.http.header_mutation:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutationPerRoute
                                            mutations:
                                                request_mutations:
                                                    - append:
                                                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                                        header:
                                                            key: X-Scope-OrgID
                                                            value: '%FILTER_STATE(auth_gateway.attributes.requested_tenant:PLAIN)%'
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        envoy.filters.http.set_filter_state:
                                            '@type': type.googleapis.com/envoy.config.route.v3.FilterConfig
                                            config:
                                                '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                                                on_request_headers:
                                                    - factory_key: envoy.string
                                                      format_string:
                                                        omit_empty_values: true
                                                        text_format_source:
                                                            inline_string: '%CEL((("auth_gateway.request_headers" in metadata.filter_metadata && "x-tenant" in metadata.filter_metadata["auth_gateway.request_headers"] && type(metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"]) == string && metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] != "") ? metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] : ""))%'
                                                      object_key: auth_gateway.attributes.requested_tenant
                                                      skip_if_empty: true
                                    - direct_response:
                                        status: 403
                                      match:
                                        headers:
                                            - name: :method
                                              string_match:
                                                exact: GET
                                        path: /protected
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: metrics
                                      name: api-0-metrics-route-0-method-0-access-denied
                                      stat_prefix: api-0-metrics-route-0-method-0-access-denied
                                      typed_per_filter_config:
                                        auth_gateway.request_validation:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                            rbac:
                                                rules:
                                                    action: DENY
                                                    policies:
                                                        invalid-request-headers:
                                                            condition:
                                                                call_expr:
                                                                    args:
                                                                        - call_expr:
                                                                            args:
                                                                                - const_expr:
                                                                                    string_value: x-tenant
                                                                                  id: "3"
                                                                                - id: "2"
                                                                                  select_expr:
                                                                                    field: headers
                                                                                    operand:
                                                                                        id: "1"
                                                                                        ident_expr:
                                                                                            name: request
                                                                            function: '@in'
                                                                          id: "4"
                                                                        - call_expr:
                                                                            args:
                                                                                - const_expr:
                                                                                    string_value: ','
                                                                                  id: "7"
                                                                            function: contains
                                                                            target:
                                                                                call_expr:
                                                                                    args:
                                                                                        - id: "2"
                                                                                          select_expr:
                                                                                            field: headers
                                                                                            operand:
                                                                                                id: "1"
                                                                                                ident_expr:
                                                                                                    name: request
                                                                                        - const_expr:
                                                                                            string_value: x-tenant
                                                                                          id: "3"
                                                                                    function: _[_]
                                                                                id: "5"
                                                                          id: "6"
                                                                    function: _&&_
                                                                id: "8"
                                                            permissions:
                                                                - any: true
                                                            principals:
                                                                - any: true
                                    - direct_response:
                                        status: 405
                                      match:
                                        path: /protected
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: __local
                                      name: method-not-allowed-0
                                      response_headers_to_add:
                                        - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                          header:
                                            key: allow
                                            value: GET
                                      typed_per_filter_config:
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                    - direct_response:
                                        status: 404
                                      match:
                                        prefix: /
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: __local
                                      name: not-found
                                      typed_per_filter_config:
                                        envoy.filters.http.rbac:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                  typed_per_filter_config:
                                    envoy.filters.http.jwt_authn:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                                        disabled: true
                                    envoy.filters.http.rbac:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        rbac:
                                            rules: {}
                        stat_prefix: ingress
                        stream_flush_timeout: 5s
                        stream_idle_timeout: 60s
              name: ingestion
              per_connection_buffer_limit_bytes: 1048576
kind: ConfigMap
metadata:
  name: auth-gateway-config
  namespace: observability
---
apiVersion: v1
data:
  config.yaml: |
    receivers:
      prometheus:
        config:
          scrape_configs:
            - job_name: auth-gateway
              scrape_interval: 30s
              scrape_timeout: 10s
              metrics_path: /stats/prometheus
              static_configs:
                - targets:
                    - 127.0.0.1:9901
    processors:
      transform:
        metric_statements:
          - context: metric
            statements:
              - replace_pattern(name, "^envoy_http_lua_", "")
    exporters:
      prometheus:
        endpoint: 0.0.0.0:8889
    service:
      pipelines:
        metrics:
          receivers:
            - prometheus
          processors:
            - transform
          exporters:
            - prometheus
kind: ConfigMap
metadata:
  name: auth-gateway-metrics
  namespace: observability
---
apiVersion: v1
automountServiceAccountToken: false
kind: ServiceAccount
metadata:
  labels:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  name: auth-gateway
  namespace: observability
---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  name: auth-gateway
  namespace: observability
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/instance: auth-gateway
      app.kubernetes.io/name: auth-gateway
  strategy: {}
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: auth-gateway
        app.kubernetes.io/name: auth-gateway
    spec:
      automountServiceAccountToken: false
      containers:
      - args:
        - -c
        - /etc/auth-gateway/envoy.yaml
        - --log-level
        - info
        image: envoyproxy/envoy:v1.39.1
        imagePullPolicy: IfNotPresent
        lifecycle:
          preStop:
            exec:
              command:
              - /bin/sh
              - -c
              - sleep 5
        name: envoy
        ports:
        - containerPort: 8080
          name: http
          protocol: TCP
        - containerPort: 9901
          name: admin
          protocol: TCP
        readinessProbe:
          failureThreshold: 12
          periodSeconds: 5
          tcpSocket:
            port: http
        resources:
          limits:
            cpu: "1"
            memory: 256Mi
          requests:
            cpu: 50m
            memory: 64Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
          runAsGroup: 101
          runAsNonRoot: true
          runAsUser: 101
        volumeMounts:
        - mountPath: /etc/auth-gateway
          name: config
          readOnly: true
      - args:
        - --config=/etc/collector/config.yaml
        image: otel/opentelemetry-collector-contrib:0.135.0
        imagePullPolicy: IfNotPresent
        name: metrics
        ports:
        - containerPort: 8889
          name: metrics
          protocol: TCP
        resources:
          limits:
            memory: 256Mi
          requests:
            cpu: 20m
            memory: 64Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
          runAsNonRoot: true
        volumeMounts:
        - mountPath: /etc/collector
          name: metrics-config
          readOnly: true
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      serviceAccountName: auth-gateway
      terminationGracePeriodSeconds: 30
      volumes:
      - configMap:
          items:
          - key: envoy.yaml
            path: envoy.yaml
          name: auth-gateway-config
        name: config
      - configMap:
          name: auth-gateway-metrics
        name: metrics-config
status: {}
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  name: auth-gateway
  namespace: observability
spec:
  ports:
  - name: http
    port: 80
    protocol: TCP
    targetPort: http
  - name: metrics
    port: 8889
    protocol: TCP
    targetPort: metrics
  selector:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  type: ClusterIP
status:
  loadBalancer: {}
