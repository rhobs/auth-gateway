                                  route:
                                    cluster: api-injected
                                    idle_timeout: 60s
                                    max_stream_duration:
                                        max_stream_duration: 30s
                                    prefix_rewrite: /anything/injected/
                                    timeout: 30s
                                  stat_prefix: api-0-injected-route-0-method-0-access-0-match-0
                                  typed_per_filter_config:
                                    auth_gateway.fault_injection:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.composite.v3.CompositePerRoute
                                        matcher:
                                            matcher_list:
                                                matchers:
                                                    - on_match:
                                                        action:
                                                            name: envoy.filters.http.composite.execute_filter_action
                                                            typed_config:
                                                                '@type': type.googleapis.com/envoy.extensions.filters.http.composite.v3.ExecuteFilterAction
                                                                filter_chain_name: server-0-api-0
                                                      predicate:
                                                        and_matcher:
                                                            predicate:
                                                                - or_matcher:
                                                                    predicate:
                                                                        - single_predicate:
                                                                            input:
                                                                                name: envoy.matching.inputs.filter_state
                                                                                typed_config:
                                                                                    '@type': type.googleapis.com/envoy.extensions.matching.common_inputs.network.v3.FilterStateInput
                                                                                    key: auth_gateway.attributes.tenant_id
                                                                            value_match:
                                                                                exact: tenant-a
                                                                        - single_predicate:
                                                                            input:
                                                                                name: envoy.matching.inputs.filter_state
                                                                                typed_config:
                                                                                    '@type': type.googleapis.com/envoy.extensions.matching.common_inputs.network.v3.FilterStateInput
                                                                                    key: auth_gateway.attributes.tenant_id
                                                                            value_match:
