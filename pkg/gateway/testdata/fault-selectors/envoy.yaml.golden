                                                    omit_empty_values: true
                                                    text_format_source:
                                                        inline_string: '%CEL((("auth_gateway.api_key" in metadata.filter_metadata && "identity" in metadata.filter_metadata["auth_gateway.api_key"] && type(metadata.filter_metadata["auth_gateway.api_key"]["identity"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["identity"] != "" && "auth_gateway.request_headers" in metadata.filter_metadata && "x-tenant" in metadata.filter_metadata["auth_gateway.request_headers"] && type(metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"]) == string && metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] != "") ? metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] : ""))%'
                                                  object_key: auth_gateway.attributes.requested_tenant
                                                  skip_if_empty: true
                                                - factory_key: envoy.string
                                                  format_string:
                                                    omit_empty_values: true
                                                    text_format_source:
                                                        inline_string: '%CEL((("auth_gateway.api_key" in metadata.filter_metadata && "attribute.tenant_id" in metadata.filter_metadata["auth_gateway.api_key"]) && type(metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"] != "") ? metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"] : "")%'
                                                  object_key: auth_gateway.attributes.tenant_id
                                                  skip_if_empty: true
                                                - factory_key: envoy.string
                                                  format_string:
                                                    omit_empty_values: true
                                                    text_format_source:
                                                        inline_string: '%CEL((("auth_gateway.api_key" in metadata.filter_metadata && "attribute.writer_id" in metadata.filter_metadata["auth_gateway.api_key"]) && type(metadata.filter_metadata["auth_gateway.api_key"]["attribute.writer_id"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["attribute.writer_id"] != "") ? metadata.filter_metadata["auth_gateway.api_key"]["attribute.writer_id"] : "")%'
                                                  object_key: auth_gateway.attributes.writer_id
                                                  skip_if_empty: true
                                - direct_response:
                                    status: 403
                                  match:
                                    headers:
                                        - name: :method
                                          string_match:
                                            exact: POST
                                    prefix: /healthy/
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: healthy
                                  name: api-1-healthy-route-0-method-0-access-denied
                                  stat_prefix: api-1-healthy-route-0-method-0-access-denied
                                  typed_per_filter_config:
                                    auth_gateway.request_validation:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        rbac:
                                            rules:
                                                action: DENY
                                                policies:
                                                    invalid-request-headers:
                                                        condition:
                                                            call_expr:
                                                                args:
                                                                    - call_expr:
                                                                        args:
                                                                            - const_expr:
                                                                                string_value: x-auth-path
                                                                              id: "3"
                                                                            - id: "2"
                                                                              select_expr:
                                                                                field: headers
                                                                                operand:
                                                                                    id: "1"
                                                                                    ident_expr:
                                                                                        name: request
                                                                        function: '@in'
                                                                      id: "4"
                                                                    - call_expr:
                                                                        args:
                                                                            - const_expr:
                                                                                string_value: ','
                                                                              id: "7"
                                                                        function: contains
                                                                        target:
                                                                            call_expr:
                                                                                args:
                                                                                    - id: "2"
                                                                                      select_expr:
                                                                                        field: headers
                                                                                        operand:
                                                                                            id: "1"
                                                                                            ident_expr:
                                                                                                name: request
                                                                                    - const_expr:
                                                                                        string_value: x-auth-path
                                                                                      id: "3"
                                                                                function: _[_]
                                                                            id: "5"
                                                                      id: "6"
                                                                function: _&&_
                                                            id: "8"
                                                        permissions:
                                                            - any: true
                                                        principals:
                                                            - any: true
                                - direct_response:
                                    status: 405
                                  match:
