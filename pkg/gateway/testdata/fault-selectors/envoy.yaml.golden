                                                                    - call_expr:
                                                                        args:
                                                                            - call_expr:
                                                                                args:
                                                                                    - const_expr:
                                                                                        string_value: authorization
                                                                                      id: "11"
                                                                                    - id: "10"
                                                                                      select_expr:
                                                                                        field: headers
                                                                                        operand:
                                                                                            id: "9"
                                                                                            ident_expr:
                                                                                                name: request
