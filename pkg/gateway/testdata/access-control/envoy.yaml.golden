                                                                args:
                                                                    - call_expr:
                                                                        args:
                                                                            - call_expr:
                                                                                args:
                                                                                    - const_expr:
                                                                                        string_value: x-mode
                                                                                      id: "3"
                                                                                    - id: "2"
                                                                                      select_expr:
                                                                                        field: headers
                                                                                        operand:
                                                                                            id: "1"
                                                                                            ident_expr:
                                                                                                name: request
                                                                                function: '@in'
                                                                              id: "4"
                                                                            - call_expr:
                                                                                args:
