                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                    local_reply_config:
                        mappers:
                            - filter:
                                and_filter:
                                    filters:
                                        - status_code_filter:
                                            comparison:
                                                value:
