                                                            metadata_source: ROUTE
                                                    principals:
                                                        - any: true
                            - domains:
                                - public.example.test
                              name: public.example.test
                              routes:
                                - match:
                                    headers:
                                        - name: :method
                                          string_match:
                                            exact: GET
                                    path: /protected
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: test-api
                                  name: api-0-test-api-route-0-method-0
                                  route:
                                    cluster: api-test-api
                                    timeout: 30s
                                - direct_response:
                                    status: 405
                                  match:
                                    path: /protected
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
                                  name: method-not-allowed-0
                                  response_headers_to_add:
                                    - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                      header:
                                        key: allow
                                        value: GET
                                - direct_response:
                                    status: 404
                                  match:
                                    prefix: /
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
                                  name: not-found
                    stat_prefix: ingress
                    stream_idle_timeout: 60s
          name: ingestion
          per_connection_buffer_limit_bytes: 1048576
