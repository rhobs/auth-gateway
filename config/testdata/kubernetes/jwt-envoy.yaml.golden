# Generated by github.com/rhobs/auth-gateway.
admin:
    address:
        socket_address:
            address: 127.0.0.1
            port_value: 9901
node:
    cluster: jwt-test
    id: jwt-test
static_resources:
    clusters:
        - circuit_breakers:
            thresholds:
                - max_connections: 1024
                  max_pending_requests: 1024
                  max_requests: 1024
                  max_retries: 0
          connect_timeout: 5s
          load_assignment:
            cluster_name: api-test-api
            endpoints:
                - lb_endpoints:
                    - endpoint:
                        address:
                            socket_address:
                                address: httpbin
                                port_value: 8080
          name: api-test-api
          per_connection_buffer_limit_bytes: 1048576
          type: STRICT_DNS
        - connect_timeout: 5s
          load_assignment:
            cluster_name: jwks-issuer-one
            endpoints:
                - lb_endpoints:
                    - endpoint:
                        address:
                            socket_address:
                                address: issuer-one.example.test
                                port_value: 443
          name: jwks-issuer-one
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
                '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
                common_tls_context:
                    validation_context:
                        trusted_ca:
                            filename: /etc/ssl/certs/ca-certificates.crt
                sni: issuer-one.example.test
          type: STRICT_DNS
        - connect_timeout: 5s
          load_assignment:
            cluster_name: jwks-issuer-two
            endpoints:
                - lb_endpoints:
                    - endpoint:
                        address:
                            socket_address:
                                address: issuer-two.example.test
                                port_value: 443
          name: jwks-issuer-two
          transport_socket:
            name: envoy.transport_sockets.tls
            typed_config:
                '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
                common_tls_context:
                    validation_context:
                        trusted_ca:
                            filename: /etc/ssl/certs/ca-certificates.crt
                sni: issuer-two.example.test
          type: STRICT_DNS
    listeners:
        - address:
            socket_address:
                address: 0.0.0.0
                port_value: 8080
          filter_chains:
            - filters:
                - name: envoy.filters.network.http_connection_manager
                  typed_config:
                    '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                    access_log:
                        - filter:
                            status_code_filter:
                                comparison:
                                    op: GE
                                    value:
                                        default_value: 400
                          name: envoy.access_loggers.stdout
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                            log_format:
                                json_format:
                                    bytes_received: '%BYTES_RECEIVED%'
                                    bytes_sent: '%BYTES_SENT%'
                                    connection_termination: '%CONNECTION_TERMINATION_DETAILS%'
                                    duration_ms: '%DURATION%'
                                    method: '%REQ(:METHOD)%'
                                    request_id: '%REQ(X-REQUEST-ID)%'
                                    response_code_details: '%RESPONSE_CODE_DETAILS%'
                                    response_flags: '%RESPONSE_FLAGS%'
                                    route: '%ROUTE_NAME%'
                                    status: '%RESPONSE_CODE%'
                                    timestamp: '%START_TIME%'
                                    upstream_cluster: '%UPSTREAM_CLUSTER%'
                                    upstream_host: '%UPSTREAM_HOST%'
                                    upstream_transport_failure: '%UPSTREAM_TRANSPORT_FAILURE_REASON%'
                    common_http_protocol_options:
                        headers_with_underscores_action: REJECT_REQUEST
                        idle_timeout: 60s
                        max_stream_duration: 30s
                    http_filters:
                        - name: envoy.filters.http.jwt_authn
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication
                            providers:
                                issuer-one:
                                    audiences:
                                        - gateway-test
                                    from_headers:
                                        - name: Authorization
                                          value_prefix: 'Bearer '
                                    issuer: https://issuer-one.example.test
                                    payload_in_metadata: issuer-one
                                    remote_jwks:
                                        cache_duration: 300s
                                        http_uri:
                                            cluster: jwks-issuer-one
                                            timeout: 5s
                                            uri: https://issuer-one.example.test/jwks
                                    require_expiration: true
                                issuer-two:
                                    audiences:
                                        - gateway-test
                                    from_headers:
                                        - name: Authorization
                                          value_prefix: 'Bearer '
                                    issuer: https://issuer-two.example.test
                                    payload_in_metadata: issuer-two
                                    remote_jwks:
                                        cache_duration: 300s
                                        http_uri:
                                            cluster: jwks-issuer-two
                                            timeout: 5s
                                            uri: https://issuer-two.example.test/jwks
                                    require_expiration: true
                            requirement_map:
                                server-0:
                                    requires_any:
                                        requirements:
                                            - provider_name: issuer-one
                                            - provider_name: issuer-two
                            strip_failure_response: true
                        - name: envoy.filters.http.lua
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
                            default_source_code:
                                inline_string: |-
                                    local settings = {["authenticators"]={["issuer-one"]={["attributes"]={["subject"]={["claim_path"]={"sub"},["mappings"]=nil}},["issuer"]="https://issuer-one.example.test"},["issuer-two"]={["attributes"]={["subject"]={["claim_path"]={"sub"},["mappings"]=nil}},["issuer"]="https://issuer-two.example.test"}},["managed_headers"]={},["routes"]={["api-0-test-api-route-0-method-0"]={["headers"]={}}},["servers"]={["jwt-one.example.test"]={["authenticators"]={"issuer-one","issuer-two"},["mode"]="any_of",["protected"]=true},["public.example.test"]={["protected"]=false}}}
                                    local function reject(handle)
                                      handle:respond({[":status"] = "403"}, "Forbidden")
                                    end
                                    local function mapped_attributes(authenticator, payload)
                                      local attributes = {}
                                      for name, mapping in pairs(authenticator.attributes or {}) do
                                        local value = payload
                                        for _, key in ipairs(mapping.claim_path) do
                                          if type(value) ~= "table" then value = nil; break end
                                          value = value[key]
                                        end
                                        if type(value) ~= "string" or value == "" then return nil end
                                        if mapping.mappings ~= nil then
                                          value = mapping.mappings[value]
                                          if type(value) ~= "string" or value == "" then return nil end
                                        end
                                        attributes[name] = value
                                      end
                                      return attributes
                                    end
                                    function envoy_on_request(handle)
                                      local headers = handle:headers()
                                      for _, name in ipairs(settings.managed_headers) do headers:remove(name) end
                                      local authority = string.lower((headers:get(":authority") or ""):gsub(":%d+$", ""))
                                      local server = settings.servers[authority]
                                      if server == nil or not server.protected then return end
                                      local verified = handle:streamInfo():dynamicMetadata():get("envoy.filters.http.jwt_authn") or {}
                                      local selected, combined, credentials, saw_verified = nil, {}, {}, false
                                      for _, name in ipairs(server.authenticators) do
                                        local payload = verified[name]
                                        if type(payload) == "table" then
                                          saw_verified = true
                                          local attributes = mapped_attributes(settings.authenticators[name], payload)
                                          if attributes ~= nil then
                                            if selected == nil then selected = name end
                                            credentials[#credentials + 1] = {authenticator = name, issuer = settings.authenticators[name].issuer}
                                            local conflict = false
                                            for key, value in pairs(attributes) do
                                              if combined[key] ~= nil and combined[key] ~= value then conflict = true end
                                            end
                                            if conflict then
                                              if server.mode == "all_of" then reject(handle); return end
                                            else
                                              for key, value in pairs(attributes) do combined[key] = value end
                                            end
                                            if server.mode == "any_of" then break end
                                          end
                                        end
                                      end
                                      if not saw_verified then handle:respond({[":status"] = "401"}, "Unauthorized"); return end
                                      if selected == nil or (server.mode == "all_of" and #credentials ~= #server.authenticators) then reject(handle); return end
                                      handle:streamInfo():dynamicMetadata():set("auth_gateway", "identity", {authenticator = selected, credentials = credentials, attributes = combined})
                                      local route = settings.routes[handle:streamInfo():routeName()]
                                      if route ~= nil then
                                        for _, mapping in ipairs(route.headers) do
                                          local value = combined[mapping.from_attribute]
                                          if type(value) ~= "string" then reject(handle); return end
                                          headers:replace(mapping.name, value)
                                        end
                                      end
                                    end
                        - name: envoy.filters.http.rbac
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - name: envoy.filters.http.router
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                            suppress_envoy_headers: true
                    max_request_headers_kb: 32
                    normalize_path: false
                    path_with_escaped_slashes_action: KEEP_UNCHANGED
                    request_headers_timeout: 5s
                    request_timeout: 30s
                    route_config:
                        name: ingestion
                        virtual_hosts:
                            - domains:
                                - jwt-one.example.test
                              name: jwt-one.example.test
                              routes:
                                - match:
                                    headers:
                                        - name: :method
                                          string_match:
                                            exact: GET
                                    path: /protected
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: test-api
                                  name: api-0-test-api-route-0-method-0
                                  route:
                                    cluster: api-test-api
                                    timeout: 30s
                                - direct_response:
                                    status: 405
                                  match:
                                    path: /protected
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
                                  name: method-not-allowed-0
                                  response_headers_to_add:
                                    - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                      header:
                                        key: allow
                                        value: GET
                                - direct_response:
                                    status: 404
                                  match:
                                    prefix: /
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
