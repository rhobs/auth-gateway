apiVersion: v1
data:
  config.yaml: |
    receivers:
      prometheus:
        config:
          scrape_configs:
            - job_name: auth-gateway
              scrape_interval: 30s
              metrics_path: /stats/prometheus
              static_configs:
                - targets:
                    - 127.0.0.1:9901
    exporters:
      prometheus:
        endpoint: 0.0.0.0:8889
    service:
      pipelines:
        metrics:
          receivers:
            - prometheus
          exporters:
            - prometheus
kind: ConfigMap
metadata:
  name: auth-gateway-metrics
  namespace: observability
