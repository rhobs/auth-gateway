                                    payload_in_metadata: issuer-one
                                    remote_jwks:
                                        cache_duration: 300s
                                        http_uri:
                                            cluster: jwks-issuer-one
                                            timeout: 5s
                                            uri: https://issuer-one.jwt.test/jwks
                                    require_expiration: true
                                issuer-two:
                                    audiences:
