                - max_connections: 1024
                  max_pending_requests: 1024
                  max_requests: 1024
                  max_retries: 0
          connect_timeout: 5s
          load_assignment:
            cluster_name: jwks-issuer-two
            endpoints:
                - lb_endpoints:
                    - endpoint:
                        address:
                            socket_address:
                                address: issuer-two.jwt.test
                                port_value: 443
          name: jwks-issuer-two
          transport_socket:
