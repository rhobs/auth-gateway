# Generated by github.com/rhobs/auth-gateway.
admin:
    address:
        socket_address:
            address: 127.0.0.1
            port_value: 9901
node:
    cluster: auth-gateway
    id: auth-gateway
static_resources:
    clusters:
        - circuit_breakers:
            thresholds:
                - max_connections: 1024
                  max_pending_requests: 1024
                  max_requests: 1024
                  max_retries: 0
          connect_timeout: 5s
          load_assignment:
            cluster_name: api-metrics
            endpoints:
                - lb_endpoints:
                    - endpoint:
                        address:
                            socket_address:
                                address: thanos-receive
                                port_value: 19291
          name: api-metrics
          per_connection_buffer_limit_bytes: 1048576
          type: STRICT_DNS
        - circuit_breakers:
            thresholds:
                - max_connections: 1024
                  max_pending_requests: 1024
                  max_requests: 1024
                  max_retries: 0
          connect_timeout: 5s
          load_assignment:
            cluster_name: jwks-issuer-one
            endpoints:
                - lb_endpoints:
                    - endpoint:
