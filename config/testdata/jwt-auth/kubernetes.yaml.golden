apiVersion: v1
data:
  envoy.yaml: |
    # Generated by github.com/rhobs/auth-gateway.
    admin:
        address:
            socket_address:
                address: 127.0.0.1
                port_value: 9901
    node:
        cluster: auth-gateway
        id: auth-gateway
    static_resources:
        clusters:
            - circuit_breakers:
                thresholds:
                    - max_connections: 1024
                      max_pending_requests: 1024
                      max_requests: 1024
                      max_retries: 0
              connect_timeout: 5s
              load_assignment:
                cluster_name: api-metrics
                endpoints:
                    - lb_endpoints:
                        - endpoint:
                            address:
                                socket_address:
                                    address: thanos-receive
                                    port_value: 19291
              name: api-metrics
              per_connection_buffer_limit_bytes: 1048576
              type: STRICT_DNS
              typed_extension_protocol_options:
                envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
                    '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
                    explicit_http_config:
                        http_protocol_options: {}
            - circuit_breakers:
                thresholds:
                    - max_connections: 1024
                      max_pending_requests: 1024
                      max_requests: 1024
                      max_retries: 0
              connect_timeout: 5s
              load_assignment:
                cluster_name: jwks-internal-jwt
                endpoints:
                    - lb_endpoints:
                        - endpoint:
                            address:
                                socket_address:
                                    address: issuer-one.jwt.test
                                    port_value: 443
              name: jwks-internal-jwt
              transport_socket:
                name: envoy.transport_sockets.tls
                typed_config:
                    '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
                    common_tls_context:
                        tls_params:
                            tls_maximum_protocol_version: TLSv1_3
                            tls_minimum_protocol_version: TLSv1_2
                        validation_context:
                            match_typed_subject_alt_names:
                                - matcher:
                                    exact: issuer-one.jwt.test
                                  san_type: DNS
                            trusted_ca:
                                filename: /etc/pki/tls/certs/ca-bundle.crt
                    sni: issuer-one.jwt.test
              type: STRICT_DNS
        listeners:
            - address:
                socket_address:
                    address: 0.0.0.0
                    port_value: 8080
              filter_chains:
                - filters:
                    - name: envoy.filters.network.http_connection_manager
                      typed_config:
                        '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                        access_log:
                            - filter:
                                status_code_filter:
                                    comparison:
                                        op: GE
                                        value:
                                            default_value: 400
                              name: envoy.access_loggers.stdout
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                                log_format:
                                    json_format:
                                        bytes_received: '%BYTES_RECEIVED%'
                                        bytes_sent: '%BYTES_SENT%'
                                        connection_termination: '%CONNECTION_TERMINATION_DETAILS%'
                                        duration_ms: '%DURATION%'
                                        method: '%REQ(:METHOD)%'
                                        request_id: '%REQ(X-REQUEST-ID)%'
                                        response_code_details: '%RESPONSE_CODE_DETAILS%'
                                        response_flags: '%RESPONSE_FLAGS%'
                                        route: '%ROUTE_NAME%'
                                        status: '%RESPONSE_CODE%'
                                        timestamp: '%START_TIME%'
                                        upstream_cluster: '%UPSTREAM_CLUSTER%'
                                        upstream_host: '%UPSTREAM_HOST%'
                                        upstream_transport_failure: '%UPSTREAM_TRANSPORT_FAILURE_REASON%'
                        common_http_protocol_options:
                            headers_with_underscores_action: REJECT_REQUEST
                            idle_timeout: 60s
                            max_headers_count: 100
                            max_stream_duration: 30s
                        http_filters:
                            - name: auth_gateway.request_controls
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: x-envoy-retry-on
                                        - remove: x-envoy-retry-grpc-on
                                        - remove: x-envoy-max-retries
                                        - remove: x-envoy-hedge-on-per-try-timeout
                                        - remove: x-envoy-upstream-rq-timeout-ms
                                        - remove: x-envoy-upstream-rq-per-try-timeout-ms
                                        - remove: x-envoy-expected-rq-timeout-ms
                                        - remove: x-envoy-upstream-alt-stat-name
                                        - remove: x-envoy-upstream-stream-duration-ms
                                        - remove: x-envoy-upstream-rq-timeout-alt-response
                                        - remove: x-envoy-retriable-status-codes
                                        - remove: x-envoy-retriable-header-names
                                        - remove: x-auth-gateway-jwt-verified-internal-jwt
                            - name: envoy.filters.http.jwt_authn
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication
                                providers:
                                    internal-jwt:
                                        audiences:
                                            - gateway-test
                                        from_headers:
                                            - name: Authorization
                                              value_prefix: 'Bearer '
                                        issuer: https://issuer-one.jwt.test
                                        payload_in_metadata: internal-jwt
                                        remote_jwks:
                                            cache_duration: 300s
                                            http_uri:
                                                cluster: jwks-internal-jwt
                                                timeout: 5s
                                                uri: https://issuer-one.jwt.test/jwks
                                        require_expiration: true
                                requirement_map:
                                    server-0:
                                        provider_name: internal-jwt
                                strip_failure_response: true
                            - name: envoy.filters.http.rbac
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                            - name: auth_gateway.credentials
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: authorization
                                        - remove: x-auth-gateway-api-key-client
                                        - remove: x-auth-gateway-jwt-verified-internal-jwt
                            - name: envoy.filters.http.router
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                                suppress_envoy_headers: true
                        max_request_headers_kb: 32
                        normalize_path: true
                        path_with_escaped_slashes_action: UNESCAPE_AND_FORWARD
                        request_headers_timeout: 5s
                        request_timeout: 30s
                        route_config:
                            ignore_port_in_host_matching: true
                            name: ingestion
                            virtual_hosts:
                                - domains:
                                    - writer.jwt.example.test
                                  name: writer.jwt.example.test
                                  routes:
                                    - match:
                                        headers:
                                            - name: :method
                                              string_match:
                                                exact: GET
                                        path: /protected
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: metrics
                                      name: api-0-metrics-route-0-method-0
                                      route:
                                        cluster: api-metrics
                                        idle_timeout: 60s
                                        max_stream_duration:
                                            max_stream_duration: 30s
                                        path_rewrite: /anything
                                        timeout: 30s
                                      stat_prefix: api-0-metrics-route-0-method-0
                                    - direct_response:
                                        status: 405
                                      match:
                                        path: /protected
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: __local
                                      name: method-not-allowed-0
                                      response_headers_to_add:
                                        - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                          header:
                                            key: allow
                                            value: GET
                                    - direct_response:
                                        status: 404
                                      match:
                                        prefix: /
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: __local
                                      name: not-found
                                  typed_per_filter_config:
                                    envoy.filters.http.jwt_authn:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                                        requirement_name: server-0
                                    envoy.filters.http.rbac:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        rbac:
                                            rules:
                                                policies:
                                                    api-metrics:
                                                        permissions:
                                                            - sourced_metadata:
                                                                metadata_matcher:
                                                                    filter: envoy.filters.http.rbac
                                                                    path:
                                                                        - key: api
                                                                    value:
                                                                        string_match:
                                                                            exact: metrics
                                                                metadata_source: ROUTE
                                                        principals:
                                                            - or_ids:
                                                                ids:
                                                                    - sourced_metadata:
                                                                        metadata_matcher:
                                                                            filter: envoy.filters.http.jwt_authn
                                                                            path:
                                                                                - key: internal-jwt
                                                                                - key: organization
                                                                                - key: id
                                                                            value:
                                                                                or_match:
                                                                                    value_matchers:
                                                                                        - string_match:
                                                                                            exact: customer-a
                                                                                        - list_match:
                                                                                            one_of:
                                                                                                string_match:
                                                                                                    exact: customer-a
                                                    local-responses:
                                                        permissions:
                                                            - sourced_metadata:
                                                                metadata_matcher:
                                                                    filter: envoy.filters.http.rbac
                                                                    path:
                                                                        - key: api
                                                                    value:
                                                                        string_match:
                                                                            exact: __local
                                                                metadata_source: ROUTE
                                                        principals:
                                                            - any: true
                        stat_prefix: ingress
                        stream_flush_timeout: 5s
                        stream_idle_timeout: 60s
              name: ingestion
              per_connection_buffer_limit_bytes: 1048576
kind: ConfigMap
metadata:
  name: auth-gateway-config
  namespace: observability
---
apiVersion: v1
data:
  config.yaml: |
    receivers:
      prometheus:
        config:
          scrape_configs:
            - job_name: auth-gateway
              scrape_interval: 30s
              scrape_timeout: 10s
              metrics_path: /stats/prometheus
              static_configs:
                - targets:
                    - 127.0.0.1:9901
    processors:
      transform:
        metric_statements:
          - context: metric
            statements:
              - replace_pattern(name, "^envoy_http_lua_", "")
    exporters:
      prometheus:
        endpoint: 0.0.0.0:8889
    service:
      pipelines:
        metrics:
          receivers:
            - prometheus
          processors:
            - transform
          exporters:
            - prometheus
kind: ConfigMap
metadata:
  name: auth-gateway-metrics
  namespace: observability
---
apiVersion: v1
automountServiceAccountToken: false
kind: ServiceAccount
metadata:
  labels:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  name: auth-gateway
  namespace: observability
---
apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  name: auth-gateway
  namespace: observability
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/instance: auth-gateway
      app.kubernetes.io/name: auth-gateway
  strategy: {}
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: auth-gateway
        app.kubernetes.io/name: auth-gateway
    spec:
      automountServiceAccountToken: false
      containers:
      - args:
        - -c
        - /etc/auth-gateway/envoy.yaml
        - --log-level
        - info
        image: envoyproxy/envoy:v1.39.1
        imagePullPolicy: IfNotPresent
        lifecycle:
          preStop:
            exec:
              command:
              - /bin/sh
              - -c
              - sleep 5
        name: envoy
        ports:
        - containerPort: 8080
          name: http
          protocol: TCP
        - containerPort: 9901
          name: admin
          protocol: TCP
        readinessProbe:
          failureThreshold: 12
          periodSeconds: 5
          tcpSocket:
            port: http
        resources:
          limits:
            cpu: "1"
            memory: 256Mi
          requests:
            cpu: 50m
            memory: 64Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
          runAsGroup: 101
          runAsNonRoot: true
          runAsUser: 101
        volumeMounts:
        - mountPath: /etc/auth-gateway
          name: config
          readOnly: true
      - args:
        - --config=/etc/collector/config.yaml
        image: otel/opentelemetry-collector-contrib:0.135.0
        imagePullPolicy: IfNotPresent
        name: metrics
        ports:
        - containerPort: 8889
          name: metrics
          protocol: TCP
        resources:
          limits:
            memory: 256Mi
          requests:
            cpu: 20m
            memory: 64Mi
        volumeMounts:
        - mountPath: /etc/collector
          name: metrics-config
          readOnly: true
      serviceAccountName: auth-gateway
      terminationGracePeriodSeconds: 30
      volumes:
      - configMap:
          items:
          - key: envoy.yaml
            path: envoy.yaml
          name: auth-gateway-config
        name: config
      - configMap:
          name: auth-gateway-metrics
        name: metrics-config
status: {}
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  name: auth-gateway
  namespace: observability
spec:
  ports:
  - name: http
    port: 80
    protocol: TCP
    targetPort: http
  - name: metrics
    port: 8889
    protocol: TCP
    targetPort: metrics
  selector:
    app.kubernetes.io/instance: auth-gateway
    app.kubernetes.io/name: auth-gateway
  type: ClusterIP
status:
  loadBalancer: {}
