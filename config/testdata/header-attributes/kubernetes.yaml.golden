apiVersion: v1
data:
  envoy.yaml: |
    # Generated by github.com/rhobs/auth-gateway.
    admin:
        address:
            socket_address:
                address: 127.0.0.1
                port_value: 9901
    node:
        cluster: auth-gateway
        id: auth-gateway
    static_resources:
        clusters:
            - circuit_breakers:
                thresholds:
                    - max_connections: 1024
                      max_pending_requests: 1024
                      max_requests: 1024
                      max_retries: 0
              connect_timeout: 5s
              load_assignment:
                cluster_name: api-ingest
                endpoints:
                    - lb_endpoints:
                        - endpoint:
                            address:
                                socket_address:
                                    address: httpbin
                                    port_value: 8080
              name: api-ingest
              per_connection_buffer_limit_bytes: 1048576
              type: STRICT_DNS
              typed_extension_protocol_options:
                envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
                    '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
                    explicit_http_config:
                        http_protocol_options: {}
            - circuit_breakers:
                thresholds:
                    - max_connections: 1024
                      max_pending_requests: 1024
                      max_requests: 1024
                      max_retries: 0
              connect_timeout: 5s
              dns_lookup_family: V4_ONLY
              load_assignment:
                cluster_name: jwks-issuer-one
                endpoints:
                    - lb_endpoints:
                        - endpoint:
                            address:
                                socket_address:
                                    address: issuer-one.jwt.test
                                    port_value: 443
              name: jwks-issuer-one
              transport_socket:
                name: envoy.transport_sockets.tls
                typed_config:
                    '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
                    common_tls_context:
                        tls_params:
                            tls_maximum_protocol_version: TLSv1_3
                            tls_minimum_protocol_version: TLSv1_2
                        validation_context:
                            match_typed_subject_alt_names:
                                - matcher:
                                    exact: issuer-one.jwt.test
                                  san_type: DNS
                            trusted_ca:
                                filename: /etc/ssl/certs/ca-certificates.crt
                    sni: issuer-one.jwt.test
              type: STRICT_DNS
        listeners:
            - address:
                socket_address:
                    address: 0.0.0.0
                    port_value: 8080
              filter_chains:
                - filters:
                    - name: envoy.filters.network.http_connection_manager
                      typed_config:
                        '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                        access_log:
                            - filter:
                                status_code_filter:
                                    comparison:
                                        op: GE
                                        value:
                                            default_value: 400
                              name: envoy.access_loggers.stdout
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                                log_format:
                                    json_format:
                                        bytes_received: '%BYTES_RECEIVED%'
                                        bytes_sent: '%BYTES_SENT%'
                                        connection_termination: '%CONNECTION_TERMINATION_DETAILS%'
                                        duration_ms: '%DURATION%'
                                        method: '%REQ(:METHOD)%'
                                        path: '%PATH(NQ)%'
                                        request_id: '%REQ(X-REQUEST-ID)%'
                                        response_code_details: '%RESPONSE_CODE_DETAILS%'
                                        response_flags: '%RESPONSE_FLAGS%'
                                        route: '%ROUTE_NAME%'
                                        status: '%RESPONSE_CODE%'
                                        timestamp: '%START_TIME%'
                                        upstream_cluster: '%UPSTREAM_CLUSTER%'
                                        upstream_host: '%UPSTREAM_HOST%'
                                        upstream_transport_failure: '%UPSTREAM_TRANSPORT_FAILURE_REASON%'
                        common_http_protocol_options:
                            headers_with_underscores_action: REJECT_REQUEST
                            idle_timeout: 60s
                            max_headers_count: 100
                            max_stream_duration: 30s
                        http_filters:
                            - name: auth_gateway.request_controls
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: x-envoy-original-path
                                        - remove: x-envoy-retry-on
                                        - remove: x-envoy-retry-grpc-on
                                        - remove: x-envoy-max-retries
                                        - remove: x-envoy-hedge-on-per-try-timeout
                                        - remove: x-envoy-upstream-rq-timeout-ms
                                        - remove: x-envoy-upstream-rq-per-try-timeout-ms
                                        - remove: x-envoy-expected-rq-timeout-ms
                                        - remove: x-envoy-upstream-alt-stat-name
                                        - remove: x-envoy-upstream-stream-duration-ms
                                        - remove: x-envoy-upstream-rq-timeout-alt-response
                                        - remove: x-envoy-retriable-status-codes
                                        - remove: x-envoy-retriable-header-names
                                        - remove: x-auth-gateway-api-key-client
                                        - remove: x-auth-gateway-jwt-verified-issuer-one
                            - name: envoy.filters.http.lua
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
                                default_source_code:
                                    inline_string: |
                                        local labels = {"tenant"}
                                        local counter_name = "auth_gateway_http_requests_total"

                                        local function safe_label(value)
                                          if type(value) ~= "string" or #value == 0 or #value > 128 then
                                            return "__unattributed__"
                                          end
                                          for i = 1, #value do
                                            local byte = string.byte(value, i)
                                            if byte < 32 or byte > 126 or byte == 124 then
                                              return "__unattributed__"
                                            end
                                          end
                                          return value
                                        end

                                        function envoy_on_response(response_handle)
                                          local metadata = response_handle:metadata()
                                          if metadata == nil then
                                            return
                                          end
                                          local api = metadata:get("api")
                                          if type(api) ~= "string" or api == "" then
                                            return
                                          end
                                          local status = response_handle:headers():get(":status")
                                          if type(status) ~= "string" or not string.match(status, "^%d%d%d$") then
                                            return
                                          end

                                          local bindings = metadata:get("labels") or {}
                                          local filter_state = response_handle:streamInfo():filterState()
                                          local name = counter_name .. "|api=" .. api .. "|http_status_code=" .. status
                                          for _, label in ipairs(labels) do
                                            local attribute = bindings[label]
                                            local value = nil
                                            if type(attribute) == "string" then
                                              value = filter_state:get("auth_gateway.attributes." .. attribute)
                                            end
                                            name = name .. "|" .. label .. "=" .. safe_label(value)
                                          end
                                          response_handle:stats():counter(name):inc()
                                        end
                            - name: envoy.filters.http.jwt_authn
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication
                                providers:
                                    issuer-one:
                                        audiences:
                                            - gateway-test
                                        claim_to_headers:
                                            - claim_name: iss
                                              header_name: x-auth-gateway-jwt-verified-issuer-one
                                        from_headers:
                                            - name: Authorization
                                              value_prefix: 'Bearer '
                                        issuer: https://issuer-one.jwt.test
                                        payload_in_metadata: issuer-one
                                        remote_jwks:
                                            cache_duration: 300s
                                            http_uri:
                                                cluster: jwks-issuer-one
                                                timeout: 5s
                                                uri: https://issuer-one.jwt.test/jwks
                                        require_expiration: true
                                requirement_map:
                                    server-0:
                                        allow_missing_or_failed: {}
                                    server-1:
                                        provider_name: issuer-one
                                strip_failure_response: true
                            - config_discovery:
                                config_source:
                                    path_config_source:
                                        path: /etc/auth-gateway/api-keys/api-keys.yaml
                                        watched_directory:
                                            path: /etc/auth-gateway/api-keys
                                    resource_api_version: V3
                                type_urls:
                                    - envoy.extensions.common.matching.v3.ExtensionWithMatcher
                              disabled: true
                              name: envoy.filters.http.api_key_auth
                            - name: envoy.filters.http.header_to_metadata
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_to_metadata.v3.Config
                                request_rules:
                                    - header: x-auth-gateway-api-key-client
                                      on_header_present:
                                        key: identity
                                        metadata_namespace: auth_gateway.api_key
                                    - header: x-auth-gateway-api-key-client
                                      on_header_present:
                                        key: attribute.tenant_id
                                        metadata_namespace: auth_gateway.api_key
                                        regex_value_rewrite:
                                            pattern:
                                                regex: ^tenant_id=([^;]*)$
                                            substitution: \1
                                      remove: true
                                    - header: x-tenant
                                      on_header_present:
                                        key: x-tenant
                                        metadata_namespace: auth_gateway.request_headers
                            - name: auth_gateway.authentication
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                            - disabled: true
                              name: auth_gateway.attributes.server-0
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                                on_request_headers:
                                    - factory_key: envoy.string
                                      format_string:
                                        omit_empty_values: true
                                        text_format_source:
                                            inline_string: '%CEL((("auth_gateway.api_key" in metadata.filter_metadata && "identity" in metadata.filter_metadata["auth_gateway.api_key"] && type(metadata.filter_metadata["auth_gateway.api_key"]["identity"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["identity"] != "") ? "partner-key" : ""))%'
                                      object_key: auth_gateway.authenticator
                                      skip_if_empty: true
                                    - factory_key: envoy.string
                                      format_string:
                                        omit_empty_values: true
                                        text_format_source:
                                            inline_string: '%CEL((("envoy.filters.http.jwt_authn" in metadata.filter_metadata && "issuer-one" in metadata.filter_metadata["envoy.filters.http.jwt_authn"] && "iss" in metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"] && type(metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["iss"]) == string && metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["iss"] == "https://issuer-one.jwt.test") ? "issuer-one" : ""))%'
                                      object_key: auth_gateway.authenticator
                                      skip_if_empty: true
                                    - factory_key: envoy.string
                                      format_string:
                                        omit_empty_values: true
                                        text_format_source:
                                            inline_string: '%CEL(("auth_gateway.authenticator" in filter_state && filter_state["auth_gateway.authenticator"] == b"partner-key") ? ((("auth_gateway.api_key" in metadata.filter_metadata && "identity" in metadata.filter_metadata["auth_gateway.api_key"] && type(metadata.filter_metadata["auth_gateway.api_key"]["identity"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["identity"] != "" && "auth_gateway.request_headers" in metadata.filter_metadata && "x-tenant" in metadata.filter_metadata["auth_gateway.request_headers"] && type(metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"]) == string && metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] != "") ? metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] : "")) : "")%'
                                      object_key: auth_gateway.attributes.requested_tenant
                                      skip_if_empty: true
                                    - factory_key: envoy.string
                                      format_string:
                                        omit_empty_values: true
                                        text_format_source:
                                            inline_string: '%CEL(("auth_gateway.authenticator" in filter_state && filter_state["auth_gateway.authenticator"] == b"partner-key") ? ((("auth_gateway.api_key" in metadata.filter_metadata && "attribute.tenant_id" in metadata.filter_metadata["auth_gateway.api_key"]) && type(metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"] != "") ? metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"] : "") : "")%'
                                      object_key: auth_gateway.attributes.tenant_id
                                      skip_if_empty: true
                                    - factory_key: envoy.string
                                      format_string:
                                        omit_empty_values: true
                                        text_format_source:
                                            inline_string: '%CEL(("auth_gateway.authenticator" in filter_state && filter_state["auth_gateway.authenticator"] == b"issuer-one") ? ((("envoy.filters.http.jwt_authn" in metadata.filter_metadata && "issuer-one" in metadata.filter_metadata["envoy.filters.http.jwt_authn"] && "iss" in metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"] && type(metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["iss"]) == string && metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["iss"] == "https://issuer-one.jwt.test" && "auth_gateway.request_headers" in metadata.filter_metadata && "x-tenant" in metadata.filter_metadata["auth_gateway.request_headers"] && type(metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"]) == string && metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] != "") ? metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] : "")) : "")%'
                                      object_key: auth_gateway.attributes.requested_tenant
                                      skip_if_empty: true
                                    - factory_key: envoy.string
                                      format_string:
                                        omit_empty_values: true
                                        text_format_source:
                                            inline_string: '%CEL(("auth_gateway.authenticator" in filter_state && filter_state["auth_gateway.authenticator"] == b"issuer-one") ? ((("issuer-one" in metadata.filter_metadata["envoy.filters.http.jwt_authn"] && "organization" in metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"] && "id" in metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]) && type(metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]["id"]) == string && metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]["id"] != "") ? metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]["id"] : "") : "")%'
                                      object_key: auth_gateway.attributes.tenant_id
                                      skip_if_empty: true
                            - disabled: true
                              name: auth_gateway.attributes.server-1
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                                on_request_headers:
                                    - factory_key: envoy.string
                                      format_string:
                                        omit_empty_values: true
                                        text_format_source:
                                            inline_string: '%CEL((("envoy.filters.http.jwt_authn" in metadata.filter_metadata && "issuer-one" in metadata.filter_metadata["envoy.filters.http.jwt_authn"] && "iss" in metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"] && type(metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["iss"]) == string && metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["iss"] == "https://issuer-one.jwt.test" && "auth_gateway.request_headers" in metadata.filter_metadata && "x-tenant" in metadata.filter_metadata["auth_gateway.request_headers"] && type(metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"]) == string && metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] != "") ? metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] : ""))%'
                                      object_key: auth_gateway.attributes.requested_tenant
                                      skip_if_empty: true
                                    - factory_key: envoy.string
                                      format_string:
                                        omit_empty_values: true
                                        text_format_source:
                                            inline_string: '%CEL((("issuer-one" in metadata.filter_metadata["envoy.filters.http.jwt_authn"] && "organization" in metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"] && "id" in metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]) && type(metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]["id"]) == string && metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]["id"] != "") ? metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]["id"] : "")%'
                                      object_key: auth_gateway.attributes.tenant_id
                                      skip_if_empty: true
                                    - factory_key: envoy.string
                                      format_string:
                                        omit_empty_values: true
                                        text_format_source:
                                            inline_string: '%CEL((("auth_gateway.api_key" in metadata.filter_metadata && "identity" in metadata.filter_metadata["auth_gateway.api_key"] && type(metadata.filter_metadata["auth_gateway.api_key"]["identity"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["identity"] != "" && "auth_gateway.request_headers" in metadata.filter_metadata && "x-tenant" in metadata.filter_metadata["auth_gateway.request_headers"] && type(metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"]) == string && metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] != "") ? metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] : ""))%'
                                      object_key: auth_gateway.attributes.requested_tenant
                                      skip_if_empty: true
                                    - factory_key: envoy.string
                                      format_string:
                                        omit_empty_values: true
                                        text_format_source:
                                            inline_string: '%CEL((("auth_gateway.api_key" in metadata.filter_metadata && "attribute.tenant_id" in metadata.filter_metadata["auth_gateway.api_key"]) && type(metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"] != "") ? metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"] : "")%'
                                      object_key: auth_gateway.attributes.tenant_id
                                      skip_if_empty: true
                            - name: envoy.filters.http.rbac
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                            - name: auth_gateway.required_headers
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                            - name: auth_gateway.credentials
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: authorization
                                        - remove: x-auth-gateway-api-key-client
                                        - remove: x-auth-gateway-jwt-verified-issuer-one
                                        - remove: x-partner-key
                            - name: envoy.filters.http.header_mutation
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                                mutations:
                                    request_mutations:
                                        - remove: x-scope-orgid
                            - name: envoy.filters.http.router
                              typed_config:
                                '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                        max_request_headers_kb: 32
                        normalize_path: true
                        path_with_escaped_slashes_action: UNESCAPE_AND_FORWARD
                        request_headers_timeout: 5s
                        request_timeout: 30s
                        route_config:
                            ignore_port_in_host_matching: true
                            name: ingestion
                            virtual_hosts:
                                - domains:
                                    - either.header.gateway.test
                                  name: either.header.gateway.test
                                  routes:
                                    - match:
                                        headers:
                                            - name: :method
                                              string_match:
                                                exact: POST
                                        path: /ingest
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.lua:
                                                api: ingest
                                                labels:
                                                    tenant: requested_tenant
                                            envoy.filters.http.rbac:
                                                api: ingest
                                      name: api-0-ingest-route-0-method-0
                                      route:
                                        cluster: api-ingest
                                        idle_timeout: 60s
                                        max_stream_duration:
                                            max_stream_duration: 30s
                                        path_rewrite: /anything
                                        timeout: 30s
                                      stat_prefix: api-0-ingest-route-0-method-0
                                      typed_per_filter_config:
                                        auth_gateway.required_headers:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                            rbac:
                                                rules:
                                                    policies:
                                                        required-attributes:
                                                            permissions:
                                                                - any: true
                                                            principals:
                                                                - filter_state:
                                                                    key: auth_gateway.attributes.requested_tenant
                                                                    string_match:
                                                                        safe_regex:
                                                                            regex: ^[^\x00-\x1f\x7f]+$
                                        envoy.filters.http.header_mutation:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutationPerRoute
                                            mutations:
                                                request_mutations:
                                                    - append:
                                                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                                        header:
                                                            key: X-Scope-OrgID
                                                            value: '%FILTER_STATE(auth_gateway.attributes.requested_tenant:PLAIN)%'
                                    - direct_response:
                                        status: 405
                                      match:
                                        path: /ingest
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: __local
                                      name: method-not-allowed-0
                                      response_headers_to_add:
                                        - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                          header:
                                            key: allow
                                            value: POST
                                    - direct_response:
                                        status: 404
                                      match:
                                        prefix: /
                                      metadata:
                                        filter_metadata:
                                            envoy.filters.http.rbac:
                                                api: __local
                                      name: not-found
                                  typed_per_filter_config:
                                    auth_gateway.attributes.server-0:
                                        '@type': type.googleapis.com/envoy.config.route.v3.FilterConfig
                                        config:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                                    auth_gateway.authentication:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        rbac:
                                            rules:
                                                policies:
                                                    authenticated:
                                                        permissions:
                                                            - any: true
                                                        principals:
                                                            - or_ids:
                                                                ids:
                                                                    - sourced_metadata:
                                                                        metadata_matcher:
                                                                            filter: auth_gateway.api_key
                                                                            path:
                                                                                - key: identity
                                                                            value:
                                                                                string_match:
                                                                                    safe_regex:
                                                                                        regex: ^tenant_id=[^;]*$
                                                                    - header:
                                                                        name: x-auth-gateway-jwt-verified-issuer-one
                                                                        string_match:
                                                                            exact: https://issuer-one.jwt.test
                                    envoy.filters.http.api_key_auth:
                                        '@type': type.googleapis.com/envoy.config.route.v3.FilterConfig
                                        config:
                                            '@type': type.googleapis.com/envoy.extensions.common.matching.v3.ExtensionWithMatcherPerRoute
                                            xds_matcher:
                                                matcher_list:
                                                    matchers:
                                                        - on_match:
                                                            action:
                                                                name: skip
                                                                typed_config:
                                                                    '@type': type.googleapis.com/envoy.extensions.filters.common.matcher.action.v3.SkipFilter
                                                          predicate:
                                                            single_predicate:
                                                                input:
                                                                    name: envoy.matching.inputs.request_headers
                                                                    typed_config:
                                                                        '@type': type.googleapis.com/envoy.type.matcher.v3.HttpRequestHeaderMatchInput
                                                                        header_name: x-auth-gateway-jwt-verified-issuer-one
                                                                value_match:
                                                                    exact: https://issuer-one.jwt.test
                                    envoy.filters.http.jwt_authn:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                                        requirement_name: server-0
                                    envoy.filters.http.rbac:
