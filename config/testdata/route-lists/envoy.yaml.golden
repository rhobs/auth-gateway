# Generated by github.com/rhobs/auth-gateway.
admin:
    address:
        socket_address:
            address: 127.0.0.1
            port_value: 9901
node:
    cluster: auth-gateway
    id: auth-gateway
static_resources:
    clusters:
        - circuit_breakers:
            thresholds:
                - max_connections: 1024
                  max_pending_requests: 1024
                  max_requests: 1024
                  max_retries: 0
          connect_timeout: 5s
          load_assignment:
            cluster_name: api-metrics-query
            endpoints:
                - lb_endpoints:
                    - endpoint:
                        address:
                            socket_address:
                                address: thanos-query
                                port_value: 9090
          name: api-metrics-query
          per_connection_buffer_limit_bytes: 1048576
          type: STRICT_DNS
          typed_extension_protocol_options:
            envoy.extensions.upstreams.http.v3.HttpProtocolOptions:
                '@type': type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions
                explicit_http_config:
                    http_protocol_options: {}
    listeners:
        - address:
            socket_address:
                address: 0.0.0.0
                port_value: 8080
          filter_chains:
            - filters:
                - name: envoy.filters.network.http_connection_manager
                  typed_config:
                    '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                    access_log:
                        - filter:
                            status_code_filter:
                                comparison:
                                    op: GE
                                    value:
                                        default_value: 400
                          name: envoy.access_loggers.stdout
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                            log_format:
                                json_format:
                                    bytes_received: '%BYTES_RECEIVED%'
                                    bytes_sent: '%BYTES_SENT%'
                                    connection_termination: '%CONNECTION_TERMINATION_DETAILS%'
                                    duration_ms: '%DURATION%'
                                    method: '%REQ(:METHOD)%'
                                    request_id: '%REQ(X-REQUEST-ID)%'
                                    response_code_details: '%RESPONSE_CODE_DETAILS%'
                                    response_flags: '%RESPONSE_FLAGS%'
                                    route: '%ROUTE_NAME%'
                                    status: '%RESPONSE_CODE%'
                                    timestamp: '%START_TIME%'
                                    upstream_cluster: '%UPSTREAM_CLUSTER%'
                                    upstream_host: '%UPSTREAM_HOST%'
                                    upstream_transport_failure: '%UPSTREAM_TRANSPORT_FAILURE_REASON%'
                    common_http_protocol_options:
                        headers_with_underscores_action: REJECT_REQUEST
                        idle_timeout: 60s
                        max_headers_count: 100
                        max_stream_duration: 30s
                    http_filters:
                        - name: auth_gateway.request_controls
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: x-envoy-retry-on
                                    - remove: x-envoy-retry-grpc-on
                                    - remove: x-envoy-max-retries
                                    - remove: x-envoy-hedge-on-per-try-timeout
                                    - remove: x-envoy-upstream-rq-timeout-ms
                                    - remove: x-envoy-upstream-rq-per-try-timeout-ms
                                    - remove: x-envoy-expected-rq-timeout-ms
                                    - remove: x-envoy-upstream-alt-stat-name
                                    - remove: x-envoy-upstream-stream-duration-ms
                                    - remove: x-envoy-upstream-rq-timeout-alt-response
                                    - remove: x-envoy-retriable-status-codes
                                    - remove: x-envoy-retriable-header-names
                        - name: envoy.filters.http.router
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                            suppress_envoy_headers: true
                    max_request_headers_kb: 32
                    normalize_path: false
                    path_with_escaped_slashes_action: KEEP_UNCHANGED
                    request_headers_timeout: 5s
                    request_timeout: 30s
                    route_config:
                        ignore_port_in_host_matching: true
                        name: ingestion
                        virtual_hosts:
                            - domains:
                                - query.example.com
                              name: query.example.com
                              routes:
                                - match:
                                    headers:
                                        - name: :method
                                          string_match:
                                            exact: GET
                                    safe_regex:
                                        regex: ^/metrics/api/v1/(query|query_range)$
                                  name: api-0-metrics-query-route-0-method-0
                                  route:
                                    cluster: api-metrics-query
                                    idle_timeout: 60s
                                    max_stream_duration:
                                        max_stream_duration: 30s
                                    regex_rewrite:
                                        pattern:
                                            regex: ^/metrics/(.*)$
                                        substitution: /\1
                                    timeout: 30s
                                  stat_prefix: api-0-metrics-query-route-0-method-0
                                - match:
                                    headers:
                                        - name: :method
                                          string_match:
                                            exact: POST
                                    safe_regex:
                                        regex: ^/metrics/api/v1/(query|query_range)$
                                  name: api-0-metrics-query-route-0-method-1
                                  route:
                                    cluster: api-metrics-query
                                    idle_timeout: 60s
                                    max_stream_duration:
                                        max_stream_duration: 30s
                                    regex_rewrite:
                                        pattern:
                                            regex: ^/metrics/(.*)$
                                        substitution: /\1
                                    timeout: 30s
                                  stat_prefix: api-0-metrics-query-route-0-method-1
                                - match:
                                    headers:
                                        - name: :method
                                          string_match:
                                            exact: GET
                                    prefix: /metrics/api/v1/label/
                                  name: api-0-metrics-query-route-1-method-0
                                  route:
                                    cluster: api-metrics-query
                                    idle_timeout: 60s
                                    max_stream_duration:
                                        max_stream_duration: 30s
                                    prefix_rewrite: /api/v1/label/
                                    timeout: 30s
                                  stat_prefix: api-0-metrics-query-route-1-method-0
                                - match:
                                    headers:
                                        - name: :method
                                          string_match:
                                            exact: GET
                                    path: /metrics/api/v1/labels
                                  name: api-0-metrics-query-route-2-method-0
                                  route:
                                    cluster: api-metrics-query
                                    idle_timeout: 60s
                                    max_stream_duration:
                                        max_stream_duration: 30s
                                    path_rewrite: /api/v1/labels
                                    timeout: 30s
                                  stat_prefix: api-0-metrics-query-route-2-method-0
                                - direct_response:
                                    status: 405
                                  match:
                                    safe_regex:
                                        regex: ^/metrics/api/v1/(query|query_range)$
                                  name: method-not-allowed-0
                                  response_headers_to_add:
                                    - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                      header:
                                        key: allow
                                        value: GET, POST
                                - direct_response:
                                    status: 405
                                  match:
                                    prefix: /metrics/api/v1/label/
                                  name: method-not-allowed-1
                                  response_headers_to_add:
                                    - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                      header:
                                        key: allow
                                        value: GET
                                - direct_response:
                                    status: 405
                                  match:
                                    path: /metrics/api/v1/labels
                                  name: method-not-allowed-2
                                  response_headers_to_add:
                                    - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                      header:
                                        key: allow
                                        value: GET
                                - direct_response:
                                    status: 404
                                  match:
                                    prefix: /
                                  name: not-found
                    stat_prefix: ingress
                    stream_flush_timeout: 5s
                    stream_idle_timeout: 60s
          name: ingestion
          per_connection_buffer_limit_bytes: 1048576
