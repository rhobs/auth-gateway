                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
                            default_source_code:
                                inline_string: |
                                    local labels = {"tenant"}
                                    local counter_name = "gateway_http_requests_total"

                                    local function safe_label(value)
                                      if type(value) ~= "string" or #value == 0 or #value > 128 then
                                        return "__unattributed__"
                                      end
                                      for i = 1, #value do
                                        local byte = string.byte(value, i)
                                        if byte < 32 or byte > 126 or byte == 124 then
                                          return "__unattributed__"
                                        end
                                      end
                                      return value
                                    end

                                    function envoy_on_response(response_handle)
                                      local metadata = response_handle:metadata()
                                      if metadata == nil then
                                        return
                                      end
                                      local api = metadata:get("api")
                                      if type(api) ~= "string" or api == "" then
                                        return
                                      end
                                      local status = response_handle:headers():get(":status")
                                      if type(status) ~= "string" or not string.match(status, "^%d%d%d$") then
                                        return
                                      end

                                      local bindings = metadata:get("labels") or {}
                                      local filter_state = response_handle:streamInfo():filterState()
                                      local name = counter_name .. "|api=" .. api .. "|http_status_code=" .. status
                                      for _, label in ipairs(labels) do
                                        local attribute = bindings[label]
                                        local value = nil
                                        if type(attribute) == "string" then
                                          value = filter_state:get("auth_gateway.attributes." .. attribute)
                                        end
                                        name = name .. "|" .. label .. "=" .. safe_label(value)
                                      end
                                      response_handle:stats():counter(name):inc()
                                    end
                        - name: envoy.filters.http.jwt_authn
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication
                            providers:
                                external-jwt:
                                    audiences:
                                        - observability-ingestion
                                    from_headers:
                                        - name: Authorization
                                          value_prefix: 'Bearer '
                                    issuer: https://sso.external.example.com/realms/observability
                                    payload_in_metadata: external-jwt
                                    remote_jwks:
                                        cache_duration: 300s
                                        http_uri:
                                            cluster: jwks-external-jwt
                                            timeout: 5s
                                            uri: https://sso.external.example.com/realms/observability/protocol/openid-connect/certs
                                    require_expiration: true
                                internal-jwt:
                                    audiences:
                                        - observability-ingestion
                                    from_headers:
                                        - name: Authorization
                                          value_prefix: 'Bearer '
                                    issuer: https://sso.internal.example.com/realms/observability
                                    payload_in_metadata: internal-jwt
                                    remote_jwks:
                                        cache_duration: 300s
                                        http_uri:
                                            cluster: jwks-internal-jwt
                                            timeout: 5s
                                            uri: https://sso.internal.example.com/realms/observability/protocol/openid-connect/certs
                                    require_expiration: true
                            requirement_map:
                                server-0:
                                    requires_any:
                                        requirements:
                                            - provider_name: internal-jwt
                                            - provider_name: external-jwt
                                server-1:
                                    requires_any:
                                        requirements:
                                            - provider_name: internal-jwt
                                            - provider_name: external-jwt
                            strip_failure_response: true
                        - config_discovery:
                            config_source:
                                path_config_source:
                                    path: /etc/auth-gateway/processing/processing.yaml
                                    watched_directory:
                                        path: /etc/auth-gateway/processing
                                resource_api_version: V3
                            type_urls:
                                - envoy.extensions.filters.http.set_filter_state.v3.Config
                          name: envoy.filters.http.set_filter_state
                        - name: envoy.filters.http.rbac
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - name: auth_gateway.required_headers
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - name: auth_gateway.credentials
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: authorization
                                    - remove: x-auth-gateway-api-key-client
                                    - remove: x-auth-gateway-jwt-verified-external-jwt
                                    - remove: x-auth-gateway-jwt-verified-internal-jwt
                        - name: envoy.filters.http.header_mutation
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: x-scope-orgid
                                    - remove: x-writer-id
                        - name: envoy.filters.http.router
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                    max_request_headers_kb: 32
                    normalize_path: true
                    path_with_escaped_slashes_action: UNESCAPE_AND_FORWARD
                    request_headers_timeout: 5s
                    request_timeout: 30s
                    route_config:
                        ignore_port_in_host_matching: true
                        name: ingestion
                        virtual_hosts:
                            - domains:
                                - write.auth.example.com
                              name: write.auth.example.com
                              routes:
                                - match:
                                    headers:
                                        - name: :method
                                          string_match:
                                            exact: POST
                                    path: /metrics/api/v1/receive
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.lua:
                                            api: metrics-write
                                            labels:
                                                tenant: tenant_id
                                        envoy.filters.http.rbac:
                                            api: metrics-write
                                  name: api-0-metrics-write-route-0-method-0
                                  route:
                                    cluster: api-metrics-write
                                    idle_timeout: 60s
                                    max_stream_duration:
                                        max_stream_duration: 30s
                                    path_rewrite: /api/v1/receive
                                    timeout: 30s
                                  stat_prefix: api-0-metrics-write-route-0-method-0
                                  typed_per_filter_config:
                                    auth_gateway.required_headers:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        rbac:
                                            rules:
                                                policies:
                                                    required-attributes:
                                                        permissions:
                                                            - any: true
                                                        principals:
                                                            - and_ids:
                                                                ids:
                                                                    - filter_state:
                                                                        key: auth_gateway.attributes.tenant_id
                                                                        string_match:
                                                                            safe_regex:
                                                                                regex: ^[^\x00-\x1f\x7f]+$
                                                                    - filter_state:
                                                                        key: auth_gateway.attributes.writer_id
                                                                        string_match:
                                                                            safe_regex:
                                                                                regex: ^[^\x00-\x1f\x7f]+$
                                    envoy.filters.http.header_mutation:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutationPerRoute
                                        mutations:
                                            request_mutations:
                                                - append:
                                                    append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                                    header:
                                                        key: X-Scope-OrgID
                                                        value: '%FILTER_STATE(auth_gateway.attributes.tenant_id:PLAIN)%'
                                                - append:
                                                    append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                                    header:
                                                        key: X-Writer-ID
                                                        value: '%FILTER_STATE(auth_gateway.attributes.writer_id:PLAIN)%'
                                - match:
                                    headers:
                                        - name: :method
                                          string_match:
                                            exact: POST
                                    prefix: /logs/otlp/
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.lua:
                                            api: logs
                                            labels: {}
                                        envoy.filters.http.rbac:
                                            api: logs
                                  name: api-1-logs-route-0-method-0
                                  route:
                                    cluster: api-logs
                                    idle_timeout: 60s
                                    max_stream_duration:
                                        max_stream_duration: 30s
                                    prefix_rewrite: /otlp/
                                    timeout: 30s
                                  stat_prefix: api-1-logs-route-0-method-0
                                  typed_per_filter_config:
                                    auth_gateway.required_headers:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        rbac:
                                            rules:
                                                policies:
                                                    required-attributes:
                                                        permissions:
                                                            - any: true
                                                        principals:
                                                            - filter_state:
                                                                key: auth_gateway.attributes.tenant_id
                                                                string_match:
                                                                    safe_regex:
                                                                        regex: ^[^\x00-\x1f\x7f]+$
                                    envoy.filters.http.header_mutation:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutationPerRoute
                                        mutations:
                                            request_mutations:
                                                - append:
                                                    append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                                    header:
                                                        key: X-Scope-OrgID
                                                        value: '%FILTER_STATE(auth_gateway.attributes.tenant_id:PLAIN)%'
                                - direct_response:
                                    status: 405
                                  match:
                                    path: /metrics/api/v1/receive
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
                                  name: method-not-allowed-0
                                  response_headers_to_add:
                                    - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                      header:
                                        key: allow
                                        value: POST
                                - direct_response:
                                    status: 405
                                  match:
                                    prefix: /logs/otlp/
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
                                  name: method-not-allowed-1
                                  response_headers_to_add:
                                    - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                      header:
                                        key: allow
                                        value: POST
                                - direct_response:
                                    status: 404
                                  match:
                                    prefix: /
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
                                  name: not-found
                              typed_per_filter_config:
                                envoy.filters.http.jwt_authn:
                                    '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                                    requirement_name: server-1
                                envoy.filters.http.rbac:
                                    '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                    rbac:
                                        rules:
                                            policies:
                                                api-logs:
                                                    permissions:
                                                        - sourced_metadata:
                                                            metadata_matcher:
                                                                filter: envoy.filters.http.rbac
                                                                path:
                                                                    - key: api
                                                                value:
                                                                    string_match:
                                                                        exact: logs
                                                            metadata_source: ROUTE
                                                    principals:
                                                        - or_ids:
                                                            ids:
                                                                - sourced_metadata:
                                                                    metadata_matcher:
                                                                        filter: envoy.filters.http.jwt_authn
                                                                        path:
                                                                            - key: internal-jwt
                                                                            - key: x
                                                                            - key: "y"
                                                                            - key: z
                                                                            - key: claim
                                                                        value:
                                                                            or_match:
                                                                                value_matchers:
                                                                                    - string_match:
                                                                                        exact: client-123
                                                                                    - list_match:
                                                                                        one_of:
                                                                                            string_match:
                                                                                                exact: client-123
                                                                - sourced_metadata:
                                                                    metadata_matcher:
                                                                        filter: envoy.filters.http.jwt_authn
                                                                        path:
                                                                            - key: external-jwt
                                                                            - key: organization
                                                                            - key: id
                                                                        value:
                                                                            or_match:
                                                                                value_matchers:
                                                                                    - or_match:
                                                                                        value_matchers:
                                                                                            - string_match:
                                                                                                exact: customer-456
                                                                                            - string_match:
                                                                                                exact: customer-789
                                                                                    - list_match:
                                                                                        one_of:
                                                                                            or_match:
                                                                                                value_matchers:
                                                                                                    - string_match:
                                                                                                        exact: customer-456
                                                                                                    - string_match:
                                                                                                        exact: customer-789
                                                api-metrics-write:
                                                    permissions:
                                                        - sourced_metadata:
                                                            metadata_matcher:
                                                                filter: envoy.filters.http.rbac
                                                                path:
                                                                    - key: api
                                                                value:
                                                                    string_match:
                                                                        exact: metrics-write
                                                            metadata_source: ROUTE
                                                    principals:
                                                        - or_ids:
                                                            ids:
                                                                - sourced_metadata:
                                                                    metadata_matcher:
                                                                        filter: envoy.filters.http.jwt_authn
                                                                        path:
                                                                            - key: internal-jwt
                                                                            - key: x
                                                                            - key: "y"
                                                                            - key: z
                                                                            - key: claim
                                                                        value:
                                                                            or_match:
                                                                                value_matchers:
                                                                                    - or_match:
                                                                                        value_matchers:
                                                                                            - string_match:
                                                                                                exact: client-123
                                                                                            - string_match:
                                                                                                exact: client-456
                                                                                    - list_match:
                                                                                        one_of:
                                                                                            or_match:
                                                                                                value_matchers:
                                                                                                    - string_match:
                                                                                                        exact: client-123
                                                                                                    - string_match:
                                                                                                        exact: client-456
                                                                - sourced_metadata:
                                                                    metadata_matcher:
                                                                        filter: envoy.filters.http.jwt_authn
                                                                        path:
                                                                            - key: external-jwt
                                                                            - key: organization
                                                                            - key: id
                                                                        value:
                                                                            or_match:
                                                                                value_matchers:
                                                                                    - string_match:
                                                                                        exact: customer-456
                                                                                    - list_match:
                                                                                        one_of:
                                                                                            string_match:
                                                                                                exact: customer-456
                                                local-responses:
                                                    permissions:
                                                        - sourced_metadata:
                                                            metadata_matcher:
                                                                filter: envoy.filters.http.rbac
                                                                path:
                                                                    - key: api
                                                                value:
                                                                    string_match:
                                                                        exact: __local
                                                            metadata_source: ROUTE
                                                    principals:
                                                        - any: true
                    stat_prefix: ingress
                    stream_flush_timeout: 5s
                    stream_idle_timeout: 60s
              transport_socket:
                name: envoy.transport_sockets.tls
                typed_config:
                    '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
                    common_tls_context:
                        alpn_protocols:
                            - h2
                            - http/1.1
                        tls_certificate_sds_secret_configs:
                            - name: gateway_server_1
                              sds_config:
                                path_config_source:
                                    path: /etc/auth-gateway/server-certificate-1.yaml
                                    watched_directory:
                                        path: /etc/auth-gateway
                                resource_api_version: V3
                        tls_params:
                            tls_maximum_protocol_version: TLSv1_3
                            tls_minimum_protocol_version: TLSv1_2
              transport_socket_connect_timeout: 5s
          listener_filters:
            - name: envoy.filters.listener.tls_inspector
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.listener.tls_inspector.v3.TlsInspector
          name: ingestion
          per_connection_buffer_limit_bytes: 1048576
stats_config:
    stats_tags:
        - regex: ^http\.ingress\.lua\.gateway_http_requests_total(\|api=([^|]+))
          tag_name: api
        - regex: ^http\.ingress\.lua\.gateway_http_requests_total\|api=[^|]+(\|http_status_code=([^|]+))
          tag_name: http_status_code
        - regex: ^http\.ingress\.lua\.gateway_http_requests_total\|api=[^|]+\|http_status_code=[^|]+(\|tenant=([^|]+))
          tag_name: tenant
