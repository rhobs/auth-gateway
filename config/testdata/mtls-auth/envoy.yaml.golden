                                                                    string_match:
                                                                        exact: https://issuer-one.jwt.test
                                envoy.filters.http.api_key_auth:
                                    '@type': type.googleapis.com/envoy.config.route.v3.FilterConfig
                                    config:
                                        '@type': type.googleapis.com/envoy.extensions.common.matching.v3.ExtensionWithMatcherPerRoute
                                        xds_matcher:
                                            matcher_list:
                                                matchers:
                                                    - on_match:
                                                        action:
                                                            name: skip
                                                            typed_config:
                                                                '@type': type.googleapis.com/envoy.extensions.filters.common.matcher.action.v3.SkipFilter
                                                      predicate:
                                                        single_predicate:
                                                            input:
                                                                name: envoy.matching.inputs.request_headers
                                                                typed_config:
                                                                    '@type': type.googleapis.com/envoy.type.matcher.v3.HttpRequestHeaderMatchInput
                                                                    header_name: x-auth-gateway-jwt-verified-issuer-one
                                                            value_match:
                                                                exact: https://issuer-one.jwt.test
                                                    - on_match:
                                                        action:
                                                            name: skip
                                                            typed_config:
                                                                '@type': type.googleapis.com/envoy.extensions.filters.common.matcher.action.v3.SkipFilter
                                                      predicate:
                                                        single_predicate:
                                                            input:
                                                                name: envoy.matching.inputs.request_headers
                                                                typed_config:
                                                                    '@type': type.googleapis.com/envoy.type.matcher.v3.HttpRequestHeaderMatchInput
                                                                    header_name: x-auth-gateway-mtls-fingerprint
                                                            value_match:
                                                                safe_regex:
                                                                    google_re2: {}
                                                                    regex: ^[0-9A-Fa-f:]+$
                                envoy.filters.http.jwt_authn:
                                    '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                                    requirement_name: server-1
                                envoy.filters.http.rbac:
                                    '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                    rbac:
                                        rules:
                                            policies:
                                                api-ingest:
                                                    permissions:
                                                        - sourced_metadata:
                                                            metadata_matcher:
                                                                filter: envoy.filters.http.rbac
                                                                path:
                                                                    - key: api
                                                                value:
                                                                    string_match:
                                                                        exact: ingest
                                                            metadata_source: ROUTE
                                                    principals:
                                                        - or_ids:
                                                            ids:
                                                                - and_ids:
                                                                    ids:
                                                                        - sourced_metadata:
                                                                            metadata_matcher:
                                                                                filter: envoy.filters.http.jwt_authn
                                                                                path:
                                                                                    - key: issuer-one
                                                                                    - key: organization
                                                                                    - key: id
                                                                                value:
                                                                                    or_match:
                                                                                        value_matchers:
                                                                                            - string_match:
                                                                                                exact: spiffe://clients.example.test/client-a
                                                                                            - list_match:
                                                                                                one_of:
                                                                                                    string_match:
                                                                                                        exact: spiffe://clients.example.test/client-a
                                                                        - header:
                                                                            name: x-auth-gateway-jwt-verified-issuer-one
                                                                            string_match:
                                                                                exact: https://issuer-one.jwt.test
                                                                - and_ids:
                                                                    ids:
                                                                        - and_ids:
                                                                            ids:
                                                                                - header:
                                                                                    name: x-auth-gateway-mtls-fingerprint
                                                                                    string_match:
                                                                                        safe_regex:
                                                                                            regex: ^[0-9A-Fa-f:]+$
                                                                                - sourced_metadata:
                                                                                    metadata_matcher:
                                                                                        filter: auth_gateway.mtls
                                                                                        path:
                                                                                            - key: dns_san
                                                                                        value:
                                                                                            string_match:
                                                                                                exact: client-a.example.test
                                                                                - sourced_metadata:
                                                                                    metadata_matcher:
                                                                                        filter: auth_gateway.mtls
                                                                                        path:
                                                                                            - key: uri_san
                                                                                        value:
                                                                                            string_match:
                                                                                                exact: spiffe://clients.example.test/client-a
                                                                        - not_id:
                                                                            header:
                                                                                name: x-auth-gateway-jwt-verified-issuer-one
                                                                                string_match:
                                                                                    exact: https://issuer-one.jwt.test
                                                                - and_ids:
                                                                    ids:
                                                                        - and_ids:
                                                                            ids:
                                                                                - and_ids:
                                                                                    ids:
                                                                                        - sourced_metadata:
                                                                                            metadata_matcher:
                                                                                                filter: auth_gateway.api_key
                                                                                                path:
                                                                                                    - key: identity
                                                                                                value:
                                                                                                    string_match:
                                                                                                        safe_regex:
                                                                                                            regex: ^tenant_id=[^;]*$
                                                                                        - sourced_metadata:
                                                                                            metadata_matcher:
                                                                                                filter: auth_gateway.api_key
                                                                                                path:
                                                                                                    - key: attribute.tenant_id
                                                                                                value:
                                                                                                    string_match:
                                                                                                        exact: spiffe://clients.example.test/client-a
                                                                                - not_id:
                                                                                    header:
                                                                                        name: x-auth-gateway-jwt-verified-issuer-one
                                                                                        string_match:
                                                                                            exact: https://issuer-one.jwt.test
                                                                        - not_id:
                                                                            header:
                                                                                name: x-auth-gateway-mtls-fingerprint
                                                                                string_match:
                                                                                    safe_regex:
                                                                                        regex: ^[0-9A-Fa-f:]+$
                                                local-responses:
                                                    permissions:
                                                        - sourced_metadata:
                                                            metadata_matcher:
                                                                filter: envoy.filters.http.rbac
                                                                path:
                                                                    - key: api
                                                                value:
                                                                    string_match:
                                                                        exact: __local
                                                            metadata_source: ROUTE
                                                    principals:
                                                        - any: true
                    stat_prefix: ingress
                    stream_flush_timeout: 5s
                    stream_idle_timeout: 60s
              transport_socket:
                name: envoy.transport_sockets.tls
                typed_config:
                    '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
                    common_tls_context:
                        alpn_protocols:
                            - h2
                            - http/1.1
                        tls_certificate_sds_secret_configs:
                            - name: gateway_server_1
                              sds_config:
                                path_config_source:
                                    path: /etc/auth-gateway/server-certificate-1.yaml
                                    watched_directory:
                                        path: /etc/auth-gateway
                                resource_api_version: V3
                        tls_params:
                            tls_maximum_protocol_version: TLSv1_3
                            tls_minimum_protocol_version: TLSv1_2
                        validation_context_sds_secret_config:
                            name: gateway_client_ca_1
                            sds_config:
                                path_config_source:
                                    path: /etc/auth-gateway/client-ca-1.yaml
                                    watched_directory:
                                        path: /etc/auth-gateway
                                resource_api_version: V3
                    disable_stateful_session_resumption: true
                    disable_stateless_session_resumption: true
                    require_client_certificate: false
              transport_socket_connect_timeout: 5s
            - filter_chain_match:
                server_names:
                    - all.gateway.test
                transport_protocol: tls
              filters:
                - name: envoy.filters.network.http_connection_manager
                  typed_config:
                    '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                    access_log:
                        - filter:
                            status_code_filter:
                                comparison:
                                    op: GE
                                    value:
                                        default_value: 400
                          name: envoy.access_loggers.stdout
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                            log_format:
                                json_format:
                                    bytes_received: '%BYTES_RECEIVED%'
                                    bytes_sent: '%BYTES_SENT%'
                                    connection_termination: '%CONNECTION_TERMINATION_DETAILS%'
                                    duration_ms: '%DURATION%'
                                    method: '%REQ(:METHOD)%'
                                    path: '%PATH(NQ)%'
                                    request_id: '%REQ(X-REQUEST-ID)%'
                                    response_code_details: '%RESPONSE_CODE_DETAILS%'
                                    response_flags: '%RESPONSE_FLAGS%'
                                    route: '%ROUTE_NAME%'
                                    status: '%RESPONSE_CODE%'
                                    timestamp: '%START_TIME%'
                                    upstream_cluster: '%UPSTREAM_CLUSTER%'
                                    upstream_host: '%UPSTREAM_HOST%'
                                    upstream_transport_failure: '%UPSTREAM_TRANSPORT_FAILURE_REASON%'
                    common_http_protocol_options:
                        headers_with_underscores_action: REJECT_REQUEST
                        idle_timeout: 60s
                        max_headers_count: 100
                        max_stream_duration: 30s
                    http_filters:
                        - name: auth_gateway.request_controls
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: x-envoy-original-path
                                    - remove: x-envoy-retry-on
                                    - remove: x-envoy-retry-grpc-on
                                    - remove: x-envoy-max-retries
                                    - remove: x-envoy-hedge-on-per-try-timeout
                                    - remove: x-envoy-upstream-rq-timeout-ms
                                    - remove: x-envoy-upstream-rq-per-try-timeout-ms
                                    - remove: x-envoy-expected-rq-timeout-ms
                                    - remove: x-envoy-upstream-alt-stat-name
                                    - remove: x-envoy-upstream-stream-duration-ms
                                    - remove: x-envoy-upstream-rq-timeout-alt-response
                                    - remove: x-envoy-retriable-status-codes
                                    - remove: x-envoy-retriable-header-names
                                    - remove: x-auth-gateway-api-key-client
                                    - remove: x-auth-gateway-jwt-verified-issuer-one
                                    - remove: x-auth-gateway-mtls-authentication-pending
                                    - remove: x-auth-gateway-mtls-fingerprint
                                    - remove: x-auth-gateway-mtls-uri-san
                                    - remove: x-auth-gateway-mtls-dns-san
                        - name: envoy.filters.http.lua
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
                            default_source_code:
                                inline_string: |
                                    local labels = {"tenant"}
                                    local counter_name = "auth_gateway_http_requests_total"

                                    local function safe_label(value)
                                      if type(value) ~= "string" or #value == 0 or #value > 128 then
                                        return "__unattributed__"
                                      end
                                      for i = 1, #value do
                                        local byte = string.byte(value, i)
                                        if byte < 32 or byte > 126 or byte == 124 then
                                          return "__unattributed__"
                                        end
                                      end
                                      return value
                                    end

                                    function envoy_on_response(response_handle)
                                      local metadata = response_handle:metadata()
                                      if metadata == nil then
                                        return
                                      end
                                      local api = metadata:get("api")
                                      if type(api) ~= "string" or api == "" then
                                        return
                                      end
                                      local status = response_handle:headers():get(":status")
                                      if type(status) ~= "string" or not string.match(status, "^%d%d%d$") then
                                        return
                                      end

                                      local bindings = metadata:get("labels") or {}
                                      local filter_state = response_handle:streamInfo():filterState()
                                      local name = counter_name .. "|api=" .. api .. "|http_status_code=" .. status
                                      for _, label in ipairs(labels) do
                                        local attribute = bindings[label]
                                        local value = nil
                                        if type(attribute) == "string" then
                                          value = filter_state:get("auth_gateway.attributes." .. attribute)
                                        end
                                        name = name .. "|" .. label .. "=" .. safe_label(value)
                                      end
                                      response_handle:stats():counter(name):inc()
                                    end
                        - name: auth_gateway.mtls.peer_headers
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - append:
                                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                        header:
                                            key: x-auth-gateway-mtls-authentication-pending
                                            value: "true"
                                    - append:
                                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                        header:
                                            key: x-auth-gateway-mtls-fingerprint
                                            value: '%DOWNSTREAM_PEER_FINGERPRINT_256%'
                                    - append:
                                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                        header:
                                            key: x-auth-gateway-mtls-uri-san
                                            value: '%DOWNSTREAM_PEER_URI_SAN%'
                                    - append:
                                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                        header:
                                            key: x-auth-gateway-mtls-dns-san
                                            value: '%DOWNSTREAM_PEER_DNS_SAN%'
                        - name: envoy.filters.http.jwt_authn
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication
                            providers:
                                issuer-one:
                                    audiences:
                                        - gateway-test
                                    from_headers:
                                        - name: Authorization
                                          value_prefix: 'Bearer '
                                    issuer: https://issuer-one.jwt.test
                                    payload_in_metadata: issuer-one
                                    remote_jwks:
                                        cache_duration: 300s
                                        http_uri:
                                            cluster: jwks-issuer-one
                                            timeout: 5s
                                            uri: https://jwks.jwt.test/issuer-one
                                    require_expiration: true
                            requirement_map:
                                server-2:
                                    provider_name: issuer-one
                            strip_failure_response: true
                        - config_discovery:
                            config_source:
                                path_config_source:
                                    path: /etc/auth-gateway/api-keys/api-keys.yaml
                                    watched_directory:
                                        path: /etc/auth-gateway/api-keys
                                resource_api_version: V3
                            type_urls:
                                - envoy.extensions.common.matching.v3.ExtensionWithMatcher
                          disabled: true
                          name: envoy.filters.http.api_key_auth
                        - name: envoy.filters.http.header_to_metadata
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_to_metadata.v3.Config
                            request_rules:
                                - header: x-auth-gateway-api-key-client
                                  on_header_present:
                                    key: identity
                                    metadata_namespace: auth_gateway.api_key
                                - header: x-auth-gateway-api-key-client
                                  on_header_present:
                                    key: attribute.tenant_id
                                    metadata_namespace: auth_gateway.api_key
                                    regex_value_rewrite:
                                        pattern:
                                            regex: ^tenant_id=([^;]*)$
                                        substitution: \1
                                  remove: true
                                - header: x-auth-gateway-mtls-fingerprint
                                  on_header_present:
                                    key: fingerprint
                                    metadata_namespace: auth_gateway.mtls
                                - header: x-auth-gateway-mtls-uri-san
                                  on_header_present:
                                    key: uri_san
                                    metadata_namespace: auth_gateway.mtls
                                - header: x-auth-gateway-mtls-dns-san
                                  on_header_present:
                                    key: dns_san
                                    metadata_namespace: auth_gateway.mtls
                                - header: x-tenant
                                  on_header_present:
                                    key: x-tenant
                                    metadata_namespace: auth_gateway.request_headers
                        - name: auth_gateway.authentication
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - name: auth_gateway.mtls.authentication_complete
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: x-auth-gateway-mtls-authentication-pending
                        - name: auth_gateway.mtls.san_cardinality
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                            rules:
                                action: DENY
                                policies:
                                    multiple-san:
                                        permissions:
                                            - any: true
                                        principals:
                                            - or_ids:
                                                ids:
                                                    - header:
                                                        name: x-auth-gateway-mtls-uri-san
                                                        string_match:
                                                            safe_regex:
                                                                regex: .*,.*
                                                    - header:
                                                        name: x-auth-gateway-mtls-dns-san
                                                        string_match:
                                                            safe_regex:
                                                                regex: .*,.*
                        - disabled: true
                          name: auth_gateway.mtls.shared_attributes
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - disabled: true
                          name: auth_gateway.attributes.server-2
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                            on_request_headers:
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("auth_gateway.api_key" in metadata.filter_metadata && "identity" in metadata.filter_metadata["auth_gateway.api_key"] && type(metadata.filter_metadata["auth_gateway.api_key"]["identity"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["identity"] != "" && "auth_gateway.request_headers" in metadata.filter_metadata && "x-tenant" in metadata.filter_metadata["auth_gateway.request_headers"] && type(metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"]) == string && metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] != "") ? metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] : ""))%'
                                  object_key: auth_gateway.attributes.requested_tenant
                                  skip_if_empty: true
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("auth_gateway.api_key" in metadata.filter_metadata && "attribute.tenant_id" in metadata.filter_metadata["auth_gateway.api_key"]) && type(metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"] != "") ? metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"] : "")%'
                                  object_key: auth_gateway.attributes.tenant_id
                                  skip_if_empty: true
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("auth_gateway.mtls" in metadata.filter_metadata && "fingerprint" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) == string && size(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) >= 64 && "auth_gateway.mtls" in metadata.filter_metadata && "dns_san" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["dns_san"]) == string && metadata.filter_metadata["auth_gateway.mtls"]["dns_san"] != "") ? metadata.filter_metadata["auth_gateway.mtls"]["dns_san"] : ""))%'
                                  object_key: auth_gateway.attributes.dns_id
                                  skip_if_empty: true
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("auth_gateway.mtls" in metadata.filter_metadata && "fingerprint" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) == string && size(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) >= 64 && "auth_gateway.request_headers" in metadata.filter_metadata && "x-tenant" in metadata.filter_metadata["auth_gateway.request_headers"] && type(metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"]) == string && metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] != "") ? metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] : ""))%'
                                  object_key: auth_gateway.attributes.requested_tenant
                                  skip_if_empty: true
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("auth_gateway.mtls" in metadata.filter_metadata && "fingerprint" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) == string && size(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) >= 64 && "auth_gateway.mtls" in metadata.filter_metadata && "uri_san" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["uri_san"]) == string && metadata.filter_metadata["auth_gateway.mtls"]["uri_san"] != "") ? metadata.filter_metadata["auth_gateway.mtls"]["uri_san"] : ""))%'
                                  object_key: auth_gateway.attributes.tenant_id
                                  skip_if_empty: true
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("envoy.filters.http.jwt_authn" in metadata.filter_metadata && "issuer-one" in metadata.filter_metadata["envoy.filters.http.jwt_authn"] && "iss" in metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"] && type(metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["iss"]) == string && metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["iss"] == "https://issuer-one.jwt.test" && "auth_gateway.request_headers" in metadata.filter_metadata && "x-tenant" in metadata.filter_metadata["auth_gateway.request_headers"] && type(metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"]) == string && metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] != "") ? metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] : ""))%'
                                  object_key: auth_gateway.attributes.requested_tenant
                                  skip_if_empty: true
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("issuer-one" in metadata.filter_metadata["envoy.filters.http.jwt_authn"] && "organization" in metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"] && "id" in metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]) && type(metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]["id"]) == string && metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]["id"] != "") ? metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]["id"] : "")%'
                                  object_key: auth_gateway.attributes.tenant_id
                                  skip_if_empty: true
                        - config_discovery:
                            config_source:
                                path_config_source:
                                    path: /etc/auth-gateway/processing/processing.yaml
                                    watched_directory:
                                        path: /etc/auth-gateway/processing
                                resource_api_version: V3
                            type_urls:
                                - envoy.extensions.filters.http.set_filter_state.v3.Config
                          name: envoy.filters.http.set_filter_state
                        - name: envoy.filters.http.rbac
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - name: auth_gateway.required_headers
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - name: auth_gateway.credentials
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: authorization
                                    - remove: x-auth-gateway-api-key-client
                                    - remove: x-auth-gateway-jwt-verified-issuer-one
                                    - remove: x-auth-gateway-mtls-authentication-pending
                                    - remove: x-auth-gateway-mtls-dns-san
                                    - remove: x-auth-gateway-mtls-fingerprint
                                    - remove: x-auth-gateway-mtls-uri-san
                                    - remove: x-partner-key
                        - name: envoy.filters.http.header_mutation
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: x-scope-orgid
                        - name: envoy.filters.http.router
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                    local_reply_config:
                        mappers:
                            - filter:
                                and_filter:
                                    filters:
                                        - status_code_filter:
                                            comparison:
                                                value:
                                                    default_value: 403
                                        - header_filter:
                                            header:
                                                name: x-auth-gateway-mtls-authentication-pending
                                                string_match:
                                                    exact: "true"
                                                    ignore_case: true
                              status_code: 401
                    max_request_headers_kb: 32
                    normalize_path: true
                    path_with_escaped_slashes_action: UNESCAPE_AND_FORWARD
                    request_headers_timeout: 5s
                    request_timeout: 30s
                    route_config:
                        ignore_port_in_host_matching: true
                        name: ingestion
                        virtual_hosts:
                            - domains:
                                - all.gateway.test
                              name: all.gateway.test
                              routes:
                                - match:
                                    headers:
                                        - name: :method
                                          string_match:
                                            exact: POST
                                    path: /ingest
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.lua:
                                            api: ingest
                                            labels:
                                                tenant: tenant_id
                                        envoy.filters.http.rbac:
                                            api: ingest
                                  name: api-0-ingest-route-0-method-0
                                  route:
                                    cluster: api-ingest
                                    idle_timeout: 60s
                                    max_stream_duration:
                                        max_stream_duration: 30s
                                    path_rewrite: /anything
                                    timeout: 30s
                                  stat_prefix: api-0-ingest-route-0-method-0
                                  typed_per_filter_config:
                                    auth_gateway.required_headers:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        rbac:
                                            rules:
                                                policies:
                                                    required-attributes:
                                                        permissions:
                                                            - any: true
                                                        principals:
                                                            - filter_state:
                                                                key: auth_gateway.attributes.tenant_id
                                                                string_match:
                                                                    safe_regex:
                                                                        regex: ^[^\x00-\x1f\x7f]+$
                                    envoy.filters.http.header_mutation:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutationPerRoute
                                        mutations:
                                            request_mutations:
                                                - append:
                                                    append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                                    header:
                                                        key: X-Scope-OrgID
                                                        value: '%FILTER_STATE(auth_gateway.attributes.tenant_id:PLAIN)%'
                                - direct_response:
                                    status: 405
                                  match:
                                    path: /ingest
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
                                  name: method-not-allowed-0
                                  response_headers_to_add:
                                    - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                      header:
                                        key: allow
                                        value: POST
                                - direct_response:
                                    status: 404
                                  match:
                                    prefix: /
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
                                  name: not-found
                              typed_per_filter_config:
                                auth_gateway.attributes.server-2:
                                    '@type': type.googleapis.com/envoy.config.route.v3.FilterConfig
                                    config:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                                auth_gateway.authentication:
                                    '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                    rbac:
                                        rules:
                                            policies:
                                                authenticated:
                                                    permissions:
                                                        - any: true
                                                    principals:
                                                        - and_ids:
                                                            ids:
                                                                - sourced_metadata:
                                                                    metadata_matcher:
                                                                        filter: auth_gateway.api_key
                                                                        path:
                                                                            - key: identity
                                                                        value:
                                                                            string_match:
                                                                                safe_regex:
                                                                                    regex: ^tenant_id=[^;]*$
                                                                - custom:
                                                                    name: envoy.rbac.principals.mtls_authenticated
                                                                    typed_config:
                                                                        '@type': type.googleapis.com/envoy.extensions.rbac.principals.mtls_authenticated.v3.Config
