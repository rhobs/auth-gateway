                                    rbac:
                                        rules:
                                            policies:
                                                authenticated:
                                                    permissions:
                                                        - any: true
                                                    principals:
                                                        - or_ids:
                                                            ids:
                                                                - sourced_metadata:
                                                                    metadata_matcher:
