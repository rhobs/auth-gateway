                                    key: uri_san
                                    metadata_namespace: auth_gateway.mtls
                                - header: x-auth-gateway-mtls-dns-san
                                  on_header_present:
                                    key: dns_san
                                    metadata_namespace: auth_gateway.mtls
                                - header: x-tenant
                                  on_header_present:
                                    key: x-tenant
                                    metadata_namespace: auth_gateway.request_headers
                        - name: auth_gateway.authentication
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - name: auth_gateway.mtls.authentication_complete
