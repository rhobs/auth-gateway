                                                        - any: true
                    stat_prefix: ingress
                    stream_flush_timeout: 5s
                    stream_idle_timeout: 60s
              transport_socket:
                name: envoy.transport_sockets.tls
                typed_config:
                    '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
                    common_tls_context:
                        alpn_protocols:
                            - h2
                            - http/1.1
                        tls_certificate_sds_secret_configs:
                            - name: gateway_server_2
                              sds_config:
                                path_config_source:
                                    path: /etc/auth-gateway/server-certificate-2.yaml
                                    watched_directory:
                                        path: /etc/auth-gateway
                                resource_api_version: V3
                        tls_params:
                            tls_maximum_protocol_version: TLSv1_3
                            tls_minimum_protocol_version: TLSv1_2
                        validation_context_sds_secret_config:
                            name: gateway_client_ca_2
                            sds_config:
                                path_config_source:
                                    path: /etc/auth-gateway/client-ca-2.yaml
                                    watched_directory:
                                        path: /etc/auth-gateway
                                resource_api_version: V3
                    disable_stateful_session_resumption: true
                    disable_stateless_session_resumption: true
                    require_client_certificate: true
              transport_socket_connect_timeout: 5s
            - filter_chain_match:
                server_names:
                    - trust.gateway.test
                transport_protocol: tls
              filters:
                - name: envoy.filters.network.http_connection_manager
                  typed_config:
                    '@type': type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                    access_log:
                        - filter:
                            status_code_filter:
                                comparison:
                                    op: GE
                                    value:
                                        default_value: 400
                          name: envoy.access_loggers.stdout
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                            log_format:
                                json_format:
                                    bytes_received: '%BYTES_RECEIVED%'
                                    bytes_sent: '%BYTES_SENT%'
                                    connection_termination: '%CONNECTION_TERMINATION_DETAILS%'
                                    duration_ms: '%DURATION%'
                                    method: '%REQ(:METHOD)%'
                                    path: '%PATH(NQ)%'
                                    request_id: '%REQ(X-REQUEST-ID)%'
                                    response_code_details: '%RESPONSE_CODE_DETAILS%'
                                    response_flags: '%RESPONSE_FLAGS%'
                                    route: '%ROUTE_NAME%'
                                    status: '%RESPONSE_CODE%'
                                    timestamp: '%START_TIME%'
                                    upstream_cluster: '%UPSTREAM_CLUSTER%'
                                    upstream_host: '%UPSTREAM_HOST%'
                                    upstream_transport_failure: '%UPSTREAM_TRANSPORT_FAILURE_REASON%'
                    common_http_protocol_options:
                        headers_with_underscores_action: REJECT_REQUEST
                        idle_timeout: 60s
                        max_headers_count: 100
                        max_stream_duration: 30s
                    http_filters:
                        - name: auth_gateway.request_controls
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: x-envoy-original-path
                                    - remove: x-envoy-retry-on
                                    - remove: x-envoy-retry-grpc-on
                                    - remove: x-envoy-max-retries
                                    - remove: x-envoy-hedge-on-per-try-timeout
                                    - remove: x-envoy-upstream-rq-timeout-ms
                                    - remove: x-envoy-upstream-rq-per-try-timeout-ms
                                    - remove: x-envoy-expected-rq-timeout-ms
                                    - remove: x-envoy-upstream-alt-stat-name
                                    - remove: x-envoy-upstream-stream-duration-ms
                                    - remove: x-envoy-upstream-rq-timeout-alt-response
                                    - remove: x-envoy-retriable-status-codes
                                    - remove: x-envoy-retriable-header-names
                                    - remove: x-auth-gateway-api-key-client
                                    - remove: x-auth-gateway-jwt-verified-issuer-one
                                    - remove: x-auth-gateway-mtls-authentication-pending
                                    - remove: x-auth-gateway-mtls-fingerprint
                                    - remove: x-auth-gateway-mtls-uri-san
                                    - remove: x-auth-gateway-mtls-dns-san
                        - name: envoy.filters.http.lua
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
                            default_source_code:
                                inline_string: |
                                    local labels = {"tenant"}
                                    local counter_name = "auth_gateway_http_requests_total"

                                    local function safe_label(value)
                                      if type(value) ~= "string" or #value == 0 or #value > 128 then
                                        return "__unattributed__"
                                      end
                                      for i = 1, #value do
                                        local byte = string.byte(value, i)
                                        if byte < 32 or byte > 126 or byte == 124 then
                                          return "__unattributed__"
                                        end
                                      end
                                      return value
                                    end

                                    function envoy_on_response(response_handle)
                                      local metadata = response_handle:metadata()
                                      if metadata == nil then
                                        return
                                      end
                                      local api = metadata:get("api")
                                      if type(api) ~= "string" or api == "" then
                                        return
                                      end
                                      local status = response_handle:headers():get(":status")
                                      if type(status) ~= "string" or not string.match(status, "^%d%d%d$") then
                                        return
                                      end

                                      local bindings = metadata:get("labels") or {}
                                      local filter_state = response_handle:streamInfo():filterState()
                                      local name = counter_name .. "|api=" .. api .. "|http_status_code=" .. status
                                      for _, label in ipairs(labels) do
                                        local attribute = bindings[label]
                                        local value = nil
                                        if type(attribute) == "string" then
                                          value = filter_state:get("auth_gateway.attributes." .. attribute)
                                        end
                                        name = name .. "|" .. label .. "=" .. safe_label(value)
                                      end
                                      response_handle:stats():counter(name):inc()
                                    end
                        - name: auth_gateway.mtls.peer_headers
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - append:
                                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                        header:
                                            key: x-auth-gateway-mtls-authentication-pending
                                            value: "true"
                                    - append:
                                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                        header:
                                            key: x-auth-gateway-mtls-fingerprint
                                            value: '%DOWNSTREAM_PEER_FINGERPRINT_256%'
                                    - append:
                                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                        header:
                                            key: x-auth-gateway-mtls-uri-san
                                            value: '%DOWNSTREAM_PEER_URI_SAN%'
                                    - append:
                                        append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                        header:
                                            key: x-auth-gateway-mtls-dns-san
                                            value: '%DOWNSTREAM_PEER_DNS_SAN%'
                        - name: envoy.filters.http.header_to_metadata
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_to_metadata.v3.Config
                            request_rules:
                                - header: x-auth-gateway-mtls-fingerprint
                                  on_header_present:
                                    key: fingerprint
                                    metadata_namespace: auth_gateway.mtls
                                - header: x-auth-gateway-mtls-uri-san
                                  on_header_present:
                                    key: uri_san
                                    metadata_namespace: auth_gateway.mtls
                                - header: x-auth-gateway-mtls-dns-san
                                  on_header_present:
                                    key: dns_san
                                    metadata_namespace: auth_gateway.mtls
                                - header: x-tenant
                                  on_header_present:
                                    key: x-tenant
                                    metadata_namespace: auth_gateway.request_headers
                        - name: auth_gateway.authentication
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - name: auth_gateway.mtls.authentication_complete
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: x-auth-gateway-mtls-authentication-pending
                        - name: auth_gateway.mtls.san_cardinality
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                            rules:
                                action: DENY
                                policies:
                                    multiple-san:
                                        permissions:
                                            - any: true
                                        principals:
                                            - or_ids:
                                                ids:
                                                    - header:
                                                        name: x-auth-gateway-mtls-uri-san
                                                        string_match:
                                                            safe_regex:
                                                                regex: .*,.*
                                                    - header:
                                                        name: x-auth-gateway-mtls-dns-san
                                                        string_match:
                                                            safe_regex:
                                                                regex: .*,.*
                        - disabled: true
                          name: auth_gateway.mtls.shared_attributes
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - disabled: true
                          name: auth_gateway.attributes.server-3
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                            on_request_headers:
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("auth_gateway.mtls" in metadata.filter_metadata && "fingerprint" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) == string && size(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) >= 64 && "auth_gateway.mtls" in metadata.filter_metadata && "dns_san" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["dns_san"]) == string && metadata.filter_metadata["auth_gateway.mtls"]["dns_san"] != "") ? metadata.filter_metadata["auth_gateway.mtls"]["dns_san"] : ""))%'
                                  object_key: auth_gateway.attributes.dns_id
                                  skip_if_empty: true
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("auth_gateway.mtls" in metadata.filter_metadata && "fingerprint" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) == string && size(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) >= 64 && "auth_gateway.request_headers" in metadata.filter_metadata && "x-tenant" in metadata.filter_metadata["auth_gateway.request_headers"] && type(metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"]) == string && metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] != "") ? metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] : ""))%'
                                  object_key: auth_gateway.attributes.requested_tenant
                                  skip_if_empty: true
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("auth_gateway.mtls" in metadata.filter_metadata && "fingerprint" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) == string && size(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) >= 64 && "auth_gateway.mtls" in metadata.filter_metadata && "uri_san" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["uri_san"]) == string && metadata.filter_metadata["auth_gateway.mtls"]["uri_san"] != "") ? metadata.filter_metadata["auth_gateway.mtls"]["uri_san"] : ""))%'
                                  object_key: auth_gateway.attributes.tenant_id
                                  skip_if_empty: true
                        - config_discovery:
                            config_source:
                                path_config_source:
                                    path: /etc/auth-gateway/processing/processing.yaml
                                    watched_directory:
                                        path: /etc/auth-gateway/processing
                                resource_api_version: V3
                            type_urls:
                                - envoy.extensions.filters.http.set_filter_state.v3.Config
                          name: envoy.filters.http.set_filter_state
                        - name: envoy.filters.http.rbac
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - name: auth_gateway.required_headers
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - name: auth_gateway.credentials
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: authorization
                                    - remove: x-auth-gateway-api-key-client
                                    - remove: x-auth-gateway-jwt-verified-issuer-one
                                    - remove: x-auth-gateway-mtls-authentication-pending
                                    - remove: x-auth-gateway-mtls-dns-san
                                    - remove: x-auth-gateway-mtls-fingerprint
                                    - remove: x-auth-gateway-mtls-uri-san
                                    - remove: x-partner-key
                        - name: envoy.filters.http.header_mutation
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: x-scope-orgid
                        - name: envoy.filters.http.router
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                    local_reply_config:
                        mappers:
                            - filter:
                                and_filter:
                                    filters:
                                        - status_code_filter:
                                            comparison:
                                                value:
                                                    default_value: 403
                                        - header_filter:
                                            header:
                                                name: x-auth-gateway-mtls-authentication-pending
                                                string_match:
                                                    exact: "true"
                                                    ignore_case: true
                              status_code: 401
                    max_request_headers_kb: 32
                    normalize_path: true
                    path_with_escaped_slashes_action: UNESCAPE_AND_FORWARD
                    request_headers_timeout: 5s
                    request_timeout: 30s
                    route_config:
                        ignore_port_in_host_matching: true
                        name: ingestion
                        virtual_hosts:
                            - domains:
                                - trust.gateway.test
                              name: trust.gateway.test
                              routes:
                                - match:
                                    headers:
                                        - name: :method
                                          string_match:
                                            exact: POST
                                    path: /ingest
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.lua:
                                            api: ingest
                                            labels:
                                                tenant: tenant_id
                                        envoy.filters.http.rbac:
                                            api: ingest
                                  name: api-0-ingest-route-0-method-0
                                  route:
                                    cluster: api-ingest
                                    idle_timeout: 60s
                                    max_stream_duration:
                                        max_stream_duration: 30s
                                    path_rewrite: /anything
                                    timeout: 30s
                                  stat_prefix: api-0-ingest-route-0-method-0
                                  typed_per_filter_config:
                                    auth_gateway.required_headers:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        rbac:
                                            rules:
                                                policies:
                                                    required-attributes:
                                                        permissions:
                                                            - any: true
                                                        principals:
                                                            - filter_state:
                                                                key: auth_gateway.attributes.tenant_id
                                                                string_match:
                                                                    safe_regex:
                                                                        regex: ^[^\x00-\x1f\x7f]+$
                                    envoy.filters.http.header_mutation:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutationPerRoute
                                        mutations:
                                            request_mutations:
                                                - append:
                                                    append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                                    header:
                                                        key: X-Scope-OrgID
                                                        value: '%FILTER_STATE(auth_gateway.attributes.tenant_id:PLAIN)%'
                                - direct_response:
                                    status: 405
                                  match:
                                    path: /ingest
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
                                  name: method-not-allowed-0
                                  response_headers_to_add:
                                    - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                      header:
                                        key: allow
                                        value: POST
                                - direct_response:
                                    status: 404
                                  match:
                                    prefix: /
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
                                  name: not-found
                              typed_per_filter_config:
                                auth_gateway.attributes.server-3:
                                    '@type': type.googleapis.com/envoy.config.route.v3.FilterConfig
                                    config:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                                auth_gateway.authentication:
                                    '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                    rbac:
                                        rules:
                                            policies:
                                                authenticated:
                                                    permissions:
                                                        - any: true
                                                    principals:
                                                        - custom:
                                                            name: envoy.rbac.principals.mtls_authenticated
                                                            typed_config:
                                                                '@type': type.googleapis.com/envoy.extensions.rbac.principals.mtls_authenticated.v3.Config
                                                                any_validated_client_certificate: true
                                envoy.filters.http.rbac:
                                    '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                    rbac:
                                        rules:
                                            policies:
                                                api-ingest:
                                                    permissions:
                                                        - sourced_metadata:
                                                            metadata_matcher:
                                                                filter: envoy.filters.http.rbac
                                                                path:
                                                                    - key: api
                                                                value:
                                                                    string_match:
                                                                        exact: ingest
                                                            metadata_source: ROUTE
                                                    principals:
                                                        - or_ids:
                                                            ids:
                                                                - header:
                                                                    name: x-auth-gateway-mtls-fingerprint
                                                                    string_match:
                                                                        safe_regex:
                                                                            regex: ^[0-9A-Fa-f:]+$
                                                local-responses:
                                                    permissions:
                                                        - sourced_metadata:
                                                            metadata_matcher:
                                                                filter: envoy.filters.http.rbac
                                                                path:
                                                                    - key: api
                                                                value:
                                                                    string_match:
                                                                        exact: __local
                                                            metadata_source: ROUTE
                                                    principals:
                                                        - any: true
                    stat_prefix: ingress
                    stream_flush_timeout: 5s
                    stream_idle_timeout: 60s
              transport_socket:
                name: envoy.transport_sockets.tls
                typed_config:
                    '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
                    common_tls_context:
                        alpn_protocols:
                            - h2
                            - http/1.1
                        tls_certificate_sds_secret_configs:
                            - name: gateway_server_3
                              sds_config:
                                path_config_source:
                                    path: /etc/auth-gateway/server-certificate-3.yaml
                                    watched_directory:
                                        path: /etc/auth-gateway
                                resource_api_version: V3
                        tls_params:
                            tls_maximum_protocol_version: TLSv1_3
                            tls_minimum_protocol_version: TLSv1_2
                        validation_context_sds_secret_config:
                            name: gateway_client_ca_3
                            sds_config:
                                path_config_source:
                                    path: /etc/auth-gateway/client-ca-3.yaml
                                    watched_directory:
                                        path: /etc/auth-gateway
                                resource_api_version: V3
                    disable_stateful_session_resumption: true
                    disable_stateless_session_resumption: true
                    require_client_certificate: true
              transport_socket_connect_timeout: 5s
          listener_filters:
            - name: envoy.filters.listener.tls_inspector
              typed_config:
                '@type': type.googleapis.com/envoy.extensions.filters.listener.tls_inspector.v3.TlsInspector
          name: ingestion
          per_connection_buffer_limit_bytes: 1048576
stats_config:
    stats_tags:
        - regex: ^http\.ingress\.lua\.auth_gateway_http_requests_total(\|api=([^|]+))
          tag_name: api
        - regex: ^http\.ingress\.lua\.auth_gateway_http_requests_total\|api=[^|]+(\|http_status_code=([^|]+))
          tag_name: http_status_code
        - regex: ^http\.ingress\.lua\.auth_gateway_http_requests_total\|api=[^|]+\|http_status_code=[^|]+(\|tenant=([^|]+))
          tag_name: tenant
