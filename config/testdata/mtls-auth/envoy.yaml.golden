                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: x-auth-gateway-mtls-authentication-pending
                        - name: auth_gateway.mtls.san_cardinality
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                            rules:
                                action: DENY
                                policies:
                                    multiple-san:
                                        permissions:
                                            - any: true
                                        principals:
                                            - or_ids:
                                                ids:
                                                    - header:
                                                        name: x-auth-gateway-mtls-uri-san
                                                        string_match:
                                                            safe_regex:
                                                                regex: .*,.*
                                                    - header:
                                                        name: x-auth-gateway-mtls-dns-san
                                                        string_match:
                                                            safe_regex:
                                                                regex: .*,.*
                        - disabled: true
                          name: auth_gateway.mtls.shared_attributes
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - disabled: true
                          name: auth_gateway.attributes.server-1
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                            on_request_headers:
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("auth_gateway.api_key" in metadata.filter_metadata && "identity" in metadata.filter_metadata["auth_gateway.api_key"] && type(metadata.filter_metadata["auth_gateway.api_key"]["identity"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["identity"] != "" && "auth_gateway.request_headers" in metadata.filter_metadata && "x-tenant" in metadata.filter_metadata["auth_gateway.request_headers"] && type(metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"]) == string && metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] != "") ? metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] : ""))%'
                                  object_key: auth_gateway.attributes.requested_tenant
                                  skip_if_empty: true
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("auth_gateway.api_key" in metadata.filter_metadata && "attribute.tenant_id" in metadata.filter_metadata["auth_gateway.api_key"]) && type(metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"] != "") ? metadata.filter_metadata["auth_gateway.api_key"]["attribute.tenant_id"] : "")%'
                                  object_key: auth_gateway.attributes.tenant_id
                                  skip_if_empty: true
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("auth_gateway.mtls" in metadata.filter_metadata && "fingerprint" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) == string && size(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) >= 64 && "auth_gateway.mtls" in metadata.filter_metadata && "dns_san" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["dns_san"]) == string && metadata.filter_metadata["auth_gateway.mtls"]["dns_san"] != "") ? metadata.filter_metadata["auth_gateway.mtls"]["dns_san"] : ""))%'
                                  object_key: auth_gateway.attributes.dns_id
                                  skip_if_empty: true
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("auth_gateway.mtls" in metadata.filter_metadata && "fingerprint" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) == string && size(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) >= 64 && "auth_gateway.request_headers" in metadata.filter_metadata && "x-tenant" in metadata.filter_metadata["auth_gateway.request_headers"] && type(metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"]) == string && metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] != "") ? metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] : ""))%'
                                  object_key: auth_gateway.attributes.requested_tenant
                                  skip_if_empty: true
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("auth_gateway.mtls" in metadata.filter_metadata && "fingerprint" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) == string && size(metadata.filter_metadata["auth_gateway.mtls"]["fingerprint"]) >= 64 && "auth_gateway.mtls" in metadata.filter_metadata && "uri_san" in metadata.filter_metadata["auth_gateway.mtls"] && type(metadata.filter_metadata["auth_gateway.mtls"]["uri_san"]) == string && metadata.filter_metadata["auth_gateway.mtls"]["uri_san"] != "") ? metadata.filter_metadata["auth_gateway.mtls"]["uri_san"] : ""))%'
                                  object_key: auth_gateway.attributes.tenant_id
                                  skip_if_empty: true
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("envoy.filters.http.jwt_authn" in metadata.filter_metadata && "issuer-one" in metadata.filter_metadata["envoy.filters.http.jwt_authn"] && "iss" in metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"] && type(metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["iss"]) == string && metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["iss"] == "https://issuer-one.jwt.test" && "auth_gateway.request_headers" in metadata.filter_metadata && "x-tenant" in metadata.filter_metadata["auth_gateway.request_headers"] && type(metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"]) == string && metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] != "") ? metadata.filter_metadata["auth_gateway.request_headers"]["x-tenant"] : ""))%'
                                  object_key: auth_gateway.attributes.requested_tenant
                                  skip_if_empty: true
                                - factory_key: envoy.string
                                  format_string:
                                    omit_empty_values: true
                                    text_format_source:
                                        inline_string: '%CEL((("issuer-one" in metadata.filter_metadata["envoy.filters.http.jwt_authn"] && "organization" in metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"] && "id" in metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]) && type(metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]["id"]) == string && metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]["id"] != "") ? metadata.filter_metadata["envoy.filters.http.jwt_authn"]["issuer-one"]["organization"]["id"] : "")%'
                                  object_key: auth_gateway.attributes.tenant_id
                                  skip_if_empty: true
                        - config_discovery:
                            config_source:
                                path_config_source:
                                    path: /etc/auth-gateway/processing/processing.yaml
                                    watched_directory:
                                        path: /etc/auth-gateway/processing
                                resource_api_version: V3
                            type_urls:
                                - envoy.extensions.filters.http.set_filter_state.v3.Config
                          name: envoy.filters.http.set_filter_state
                        - name: envoy.filters.http.rbac
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - name: auth_gateway.required_headers
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - name: auth_gateway.credentials
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: authorization
                                    - remove: x-auth-gateway-api-key-client
                                    - remove: x-auth-gateway-jwt-verified-issuer-one
                                    - remove: x-auth-gateway-mtls-authentication-pending
                                    - remove: x-auth-gateway-mtls-dns-san
                                    - remove: x-auth-gateway-mtls-fingerprint
                                    - remove: x-auth-gateway-mtls-uri-san
                                    - remove: x-partner-key
                        - name: envoy.filters.http.header_mutation
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: x-scope-orgid
                        - name: envoy.filters.http.router
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                    local_reply_config:
                        mappers:
                            - filter:
                                and_filter:
                                    filters:
                                        - status_code_filter:
                                            comparison:
                                                value:
                                                    default_value: 403
                                        - header_filter:
                                            header:
                                                name: x-auth-gateway-mtls-authentication-pending
                                                string_match:
                                                    exact: "true"
                                                    ignore_case: true
                              status_code: 401
                    max_request_headers_kb: 32
                    normalize_path: true
                    path_with_escaped_slashes_action: UNESCAPE_AND_FORWARD
                    request_headers_timeout: 5s
                    request_timeout: 30s
                    route_config:
                        ignore_port_in_host_matching: true
                        name: ingestion
                        virtual_hosts:
                            - domains:
                                - mixed.gateway.test
                              name: mixed.gateway.test
                              routes:
                                - match:
                                    headers:
                                        - name: :method
                                          string_match:
                                            exact: POST
                                    path: /ingest
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.lua:
                                            api: ingest
                                            labels:
                                                tenant: tenant_id
                                        envoy.filters.http.rbac:
                                            api: ingest
                                  name: api-0-ingest-route-0-method-0
                                  route:
                                    cluster: api-ingest
                                    idle_timeout: 60s
                                    max_stream_duration:
                                        max_stream_duration: 30s
                                    path_rewrite: /anything
                                    timeout: 30s
                                  stat_prefix: api-0-ingest-route-0-method-0
                                  typed_per_filter_config:
                                    auth_gateway.required_headers:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        rbac:
                                            rules:
                                                policies:
                                                    required-attributes:
                                                        permissions:
                                                            - any: true
                                                        principals:
                                                            - filter_state:
                                                                key: auth_gateway.attributes.tenant_id
                                                                string_match:
                                                                    safe_regex:
                                                                        regex: ^[^\x00-\x1f\x7f]+$
                                    envoy.filters.http.header_mutation:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutationPerRoute
                                        mutations:
                                            request_mutations:
                                                - append:
                                                    append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                                    header:
                                                        key: X-Scope-OrgID
                                                        value: '%FILTER_STATE(auth_gateway.attributes.tenant_id:PLAIN)%'
                                - direct_response:
                                    status: 405
                                  match:
                                    path: /ingest
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
                                  name: method-not-allowed-0
                                  response_headers_to_add:
                                    - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                      header:
                                        key: allow
                                        value: POST
                                - direct_response:
                                    status: 404
                                  match:
                                    prefix: /
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
                                  name: not-found
                              typed_per_filter_config:
                                auth_gateway.attributes.server-1:
                                    '@type': type.googleapis.com/envoy.config.route.v3.FilterConfig
                                    config:
