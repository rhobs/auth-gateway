                                        principals:
                                            - or_ids:
                                                ids:
                                                    - header:
                                                        name: x-auth-gateway-mtls-uri-san
                                                        string_match:
                                                            safe_regex:
                                                                regex: .*,.*
                                                    - header:
                                                        name: x-auth-gateway-mtls-dns-san
                                                        string_match:
                                                            safe_regex:
                                                                regex: .*,.*
                        - disabled: true
                          name: auth_gateway.mtls.shared_attributes
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - disabled: true
                          name: auth_gateway.attributes.server-0
                          typed_config:
