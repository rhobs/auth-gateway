                                                                                    - key: id
                                                                                value:
                                                                                    or_match:
                                                                                        value_matchers:
                                                                                            - string_match:
                                                                                                exact: spiffe://clients.example.test/client-a
                                                                                            - list_match:
                                                                                                one_of:
                                                                                                    string_match:
                                                                                                        exact: spiffe://clients.example.test/client-a
                                                                - or_ids:
