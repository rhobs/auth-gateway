receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 127.0.0.1:4317
  prometheus:
    config:
      scrape_configs:
        - job_name: auth-gateway
          scrape_interval: 5s
          scrape_timeout: 2s
          metrics_path: /stats/prometheus
          static_configs:
            - targets:
                - 127.0.0.1:9901
processors:
  batch: {}
  transform:
    metric_statements:
      - context: metric
        statements:
          - replace_pattern(name, "^envoy_http_lua_", "")
exporters:
  otlp:
    endpoint: jaeger:4317
    tls:
      insecure: true
  prometheus:
    endpoint: 0.0.0.0:8889
service:
  pipelines:
    metrics:
      receivers:
        - prometheus
      processors:
        - transform
      exporters:
        - prometheus
    traces:
      receivers:
        - otlp
      processors:
        - batch
      exporters:
        - otlp
