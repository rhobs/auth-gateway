                                                                                                    string_match:
                                                                                                        exact: metrics-writer
                                                                        - header:
                                                                            name: x-auth-gateway-jwt-verified-playground-metrics-jwt
                                                                            string_match:
                                                                                exact: https://auth.localhost:8443/metrics
                                                local-responses:
                                                    permissions:
                                                        - sourced_metadata:
                                                            metadata_matcher:
                                                                filter: envoy.filters.http.rbac
                                                                path:
                                                                    - key: api
                                                                value:
                                                                    string_match:
                                                                        exact: __local
                                                            metadata_source: ROUTE
                                                    principals:
                                                        - any: true
                    stat_prefix: ingress
                    stream_flush_timeout: 5s
                    stream_idle_timeout: 60s
                    tracing:
                        client_sampling:
                            value: 100
                        overall_sampling:
                            value: 100
                        provider:
                            name: envoy.tracers.opentelemetry
                            typed_config:
                                '@type': type.googleapis.com/envoy.config.trace.v3.OpenTelemetryConfig
                                grpc_service:
                                    envoy_grpc:
                                        cluster_name: otel-traces
                                service_name: auth-gateway-playground
                        random_sampling:
                            value: 100
                        spawn_upstream_span: true
          name: ingestion
          per_connection_buffer_limit_bytes: 1048576
stats_config:
    stats_tags:
        - regex: ^http\.ingress\.lua\.gateway_http_requests_total(\|api=([^|]+))
          tag_name: api
        - regex: ^http\.ingress\.lua\.gateway_http_requests_total\|api=[^|]+(\|http_status_code=([^|]+))
          tag_name: http_status_code
        - regex: ^http\.ingress\.lua\.gateway_http_requests_total\|api=[^|]+\|http_status_code=[^|]+(\|user_id=([^|]+))
          tag_name: user_id
