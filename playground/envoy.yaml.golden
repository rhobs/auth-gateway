                                    audiences:
                                        - auth-gateway-playground
                                    from_headers:
                                        - name: Authorization
                                          value_prefix: 'Bearer '
                                    issuer: https://auth.localhost:8443/logs
                                    payload_in_metadata: playground-logs-jwt
                                    remote_jwks:
                                        cache_duration: 300s
                                        http_uri:
                                            cluster: jwks-playground-logs-jwt
                                            timeout: 5s
                                            uri: https://mock-oauth2-server:8443/logs/jwks
                                    require_expiration: true
                                playground-metrics-jwt:
                                    audiences:
                                        - auth-gateway-playground
                                    from_headers:
                                        - name: Authorization
                                          value_prefix: 'Bearer '
                                    issuer: https://auth.localhost:8443/metrics
                                    payload_in_metadata: playground-metrics-jwt
                                    remote_jwks:
                                        cache_duration: 300s
                                        http_uri:
                                            cluster: jwks-playground-metrics-jwt
                                            timeout: 5s
                                            uri: https://mock-oauth2-server:8443/metrics/jwks
                                    require_expiration: true
                            requirement_map:
                                server-2-api-0-access-0:
                                    provider_name: playground-metrics-jwt
                                server-2-api-1-access-0:
                                    provider_name: playground-logs-jwt
                                server-3-api-0-access-1:
                                    provider_name: playground-metrics-jwt
                                server-3-api-1-access-1:
                                    provider_name: playground-logs-jwt
