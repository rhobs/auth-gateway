                                    text_format: '%CEL((("auth_gateway.api_key" in metadata.filter_metadata && "attribute.user_id" in metadata.filter_metadata["auth_gateway.api_key"]) && type(metadata.filter_metadata["auth_gateway.api_key"]["attribute.user_id"]) == string && metadata.filter_metadata["auth_gateway.api_key"]["attribute.user_id"] != "") ? metadata.filter_metadata["auth_gateway.api_key"]["attribute.user_id"] : "")%'
                                  object_key: auth_gateway.attributes.user_id
