                                    value: verified
                                - header: x-auth-gateway-api-key-client
                                  on_header_present:
                                    key: attribute.user_id
                                    metadata_namespace: auth_gateway.api_key
                                    regex_value_rewrite:
                                        pattern:
                                            regex: ^(?:(?:[^;]*;)*user_id=([^;]*)(?:;[^;]*)*|.*)$
                                        substitution: \1
                                  remove: true
                        - disabled: true
                          name: envoy.filters.http.set_filter_state
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config
                        - name: envoy.filters.http.rbac
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                            rules: {}
                        - name: auth_gateway.required_headers
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
                        - name: auth_gateway.credentials
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: authorization
                                    - remove: x-api-key
                                    - remove: x-auth-gateway-api-key-client
                                    - remove: x-auth-gateway-request-validation-pending
                        - name: envoy.filters.http.header_mutation
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
                            mutations:
                                request_mutations:
                                    - remove: x-authenticated-user
                        - name: envoy.filters.http.router
                          typed_config:
                            '@type': type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
                    local_reply_config:
                        mappers:
                            - filter:
                                and_filter:
                                    filters:
                                        - status_code_filter:
                                            comparison:
                                                value:
                                                    default_value: 403
                                        - header_filter:
                                            header:
                                                name: x-auth-gateway-request-validation-pending
                                                string_match:
                                                    exact: "true"
                              status_code: 400
                    max_request_headers_kb: 32
                    normalize_path: true
                    path_with_escaped_slashes_action: UNESCAPE_AND_FORWARD
                    request_headers_timeout: 5s
                    request_timeout: 30s
                    route_config:
                        ignore_port_in_host_matching: true
                        name: ingestion
                        virtual_hosts:
                            - domains:
                                - unprotected.localhost
                              name: unprotected.localhost
                              routes:
                                - match:
                                    headers:
                                        - name: :method
                                          string_match:
                                            exact: GET
                                    path: /anything
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: playground-public
                                  name: api-0-playground-public-route-0-method-0
                                  route:
                                    cluster: api-playground-public
                                    idle_timeout: 60s
                                    max_stream_duration:
                                        max_stream_duration: 30s
                                    timeout: 30s
                                  stat_prefix: api-0-playground-public-route-0-method-0
                                  typed_per_filter_config:
                                    envoy.filters.http.rbac:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                - direct_response:
                                    status: 405
                                  match:
                                    path: /anything
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
                                  name: method-not-allowed-0
                                  response_headers_to_add:
                                    - append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                      header:
                                        key: allow
                                        value: GET
                                  typed_per_filter_config:
                                    envoy.filters.http.rbac:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                - direct_response:
                                    status: 404
                                  match:
                                    prefix: /
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.rbac:
                                            api: __local
                                  name: not-found
                                  typed_per_filter_config:
                                    envoy.filters.http.rbac:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                              typed_per_filter_config:
                                envoy.filters.http.jwt_authn:
                                    '@type': type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                                    disabled: true
                                envoy.filters.http.rbac:
                                    '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                            - domains:
                                - api-key.localhost
                              name: api-key.localhost
                              routes:
                                - match:
                                    headers:
                                        - name: :method
                                          string_match:
                                            exact: POST
                                    path: /metrics/api/v1/receive
                                  metadata:
                                    filter_metadata:
                                        envoy.filters.http.lua:
                                            api: metrics-write
                                            labels:
                                                user_id: user_id
                                        envoy.filters.http.rbac:
                                            api: metrics-write
                                  name: api-0-metrics-write-route-0-method-0-access-0-match-0
                                  route:
                                    cluster: api-metrics-write
                                    idle_timeout: 60s
                                    max_stream_duration:
                                        max_stream_duration: 30s
                                    path_rewrite: /anything
                                    timeout: 30s
                                  stat_prefix: api-0-metrics-write-route-0-method-0-access-0-match-0
                                  typed_per_filter_config:
                                    auth_gateway.request_validation:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        rbac:
                                            rules:
                                                action: DENY
                                                policies:
                                                    invalid-request-headers:
                                                        condition:
                                                            call_expr:
                                                                args:
                                                                    - call_expr:
                                                                        args:
                                                                            - const_expr:
                                                                                string_value: x-api-key
                                                                              id: "3"
                                                                            - id: "2"
                                                                              select_expr:
                                                                                field: headers
                                                                                operand:
                                                                                    id: "1"
                                                                                    ident_expr:
                                                                                        name: request
                                                                        function: '@in'
                                                                      id: "4"
                                                                    - call_expr:
                                                                        args:
                                                                            - const_expr:
                                                                                string_value: ','
                                                                              id: "7"
                                                                        function: contains
                                                                        target:
                                                                            call_expr:
                                                                                args:
                                                                                    - id: "2"
                                                                                      select_expr:
                                                                                        field: headers
                                                                                        operand:
                                                                                            id: "1"
                                                                                            ident_expr:
                                                                                                name: request
                                                                                    - const_expr:
                                                                                        string_value: x-api-key
                                                                                      id: "3"
                                                                                function: _[_]
                                                                            id: "5"
                                                                      id: "6"
                                                                function: _&&_
                                                            id: "8"
                                                        permissions:
                                                            - any: true
                                                        principals:
                                                            - any: true
                                    auth_gateway.required_headers:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        rbac:
                                            rules:
                                                policies:
                                                    required-attributes:
                                                        permissions:
                                                            - any: true
                                                        principals:
                                                            - filter_state:
                                                                key: auth_gateway.attributes.user_id
                                                                string_match:
                                                                    safe_regex:
                                                                        regex: ^[^\x00-\x1f\x7f]+$
                                    envoy.filters.http.api_key_auth:
                                        '@type': type.googleapis.com/envoy.config.route.v3.FilterConfig
                                        config:
                                            '@type': type.googleapis.com/envoy.extensions.filters.http.api_key_auth.v3.ApiKeyAuthPerRoute
                                            forwarding:
                                                header: x-auth-gateway-api-key-client
                                                hide_credentials: true
                                    envoy.filters.http.header_mutation:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutationPerRoute
                                        mutations:
                                            request_mutations:
                                                - append:
                                                    append_action: OVERWRITE_IF_EXISTS_OR_ADD
                                                    header:
                                                        key: X-Authenticated-User
                                                        value: '%FILTER_STATE(auth_gateway.attributes.user_id:PLAIN)%'
                                    envoy.filters.http.rbac:
                                        '@type': type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBACPerRoute
                                        rbac:
                                            rules:
                                                policies:
                                                    grant-0:
                                                        permissions:
                                                            - any: true
                                                        principals:
                                                            - and_ids:
                                                                ids:
                                                                    - sourced_metadata:
                                                                        metadata_matcher:
                                                                            filter: auth_gateway.api_key
                                                                            path:
                                                                                - key: identity
                                                                            value:
                                                                                string_match:
                                                                                    exact: verified
                                                                    - sourced_metadata:
                                                                        metadata_matcher:
                                                                            filter: auth_gateway.api_key
                                                                            path:
